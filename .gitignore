.fake

# MSVC #import output. These are regenerated from the type library on every
# build, and the generated text embeds the ABSOLUTE path of the machine that
# produced it - the .tlh #includes its .tli by full path. Committing them put
# one developer's home directory into an AGPL source drop, and broke the build
# anywhere the path did not exist, because MSVC reuses a .tlh it does not judge
# stale and a fresh clone gives the .tlh and the .tlb near-identical mtimes.
*.tlh
*.tli

# Python bytecode. The three .py files under build/ are imported by their own
# dry-run tooling now and then, and the interpreter leaves this behind.
__pycache__/

# Transcripts the libraries/build-*.ps1 dependency builds write next to themselves.
libraries/build-*.log
