<Project Sdk="Microsoft.NET.Sdk">

  <!-- The regression suite's fixtures, compiled IN PLACE from ../RegressionTests
       against a server that need not be on this machine and is not driven over COM:
       the Linux server, in practice. RegressionTests.csproj is net481 with a
       COMReference to hMailServer.exe and cannot run anywhere else; this project
       links every fixture file that compiles against the REST-backed fixture layer
       under Shims/, which supplies the types those files get from COM on Windows
       (TestFixtureBase, TestSetup, hMailServer.Application and the objects under it)
       with the REST API behind them.

       The rule of this project: a test that passes here is the same test that passes
       on Windows. No fixture is edited, no assertion is weakened. A shim member that
       the API cannot answer honestly calls NotOnThisServer.Ignore with a reason that
       names the missing route, so the test is skipped with that reason and never
       passes for the wrong cause; a member that needs a route an older server does
       not have asks the server's own OpenAPI document first (ServerApi.HasRoute).

       Every file under Compile below is the Windows suite's own; nothing is copied.
       A fixture that is not listed either does not compile against the shims - it
       names a COM member the REST API has no equivalent of anywhere in the file, so
       there is nothing to link - or reads the repository it was built from rather
       than the server, which the Linux runs do not have beside them.
       docs/RegressionEnvironment.md ("On Linux") says how to run this. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- RegressionTests, because the embedded resources are found by that prefix
         (TestSetup.GetResource) and TestResources.Designer.cs names its resource
         set RegressionTests.TestResources. -->
    <RootNamespace>RegressionTests</RootNamespace>
    <AssemblyName>LinuxRegressionTests</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The fixtures were written for the Windows project, which does not enable
         these analyzers; they are not this project's to fix. -->
    <NoWarn>$(NoWarn);NUnit2005;NUnit2007;NUnit2045;SYSLIB0014;SYSLIB0057;CS0618;CS0108;CS0114;CS0162;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

