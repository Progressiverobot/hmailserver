<Project Sdk="Microsoft.NET.Sdk">

  <!-- The regression suite's socket-driven fixtures, compiled IN PLACE from
       ../RegressionTests against a server that need not be on this machine and is
       not driven over COM: the Linux server, in practice. RegressionTests.csproj is
       net481 with a COMReference to hMailServer.exe and cannot run anywhere else;
       this project links the fixture files that drive the server only through SMTP,
       IMAP, POP3 and the REST API, and supplies under Shims/ the handful of types
       those files compile against that the Windows suite gets from COM
       (TestFixtureBase, TestSetup, hMailServer.Domain and friends), backed by the
       REST API instead. A fixture that needs something the REST API cannot do gets
       Assert.Ignore with the reason, from the shim, never a weakened assertion.

       Every file under Compile below is the Windows suite's own; nothing is copied.
       A fixture that is not listed is not run here, and docs/RegressionEnvironment.md
       says how to run this. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- RegressionTests, because the embedded resources are found by that prefix
         (TestSetup.GetResource) and TestResources.Designer.cs names its resource
         set RegressionTests.TestResources. -->
    <RootNamespace>RegressionTests</RootNamespace>
    <AssemblyName>LinuxRegressionTests</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The fixtures were written for the Windows project, which does not enable
         these analyzers; they are not this project's to fix. -->
    <NoWarn>$(NoWarn);NUnit2005;NUnit2007;SYSLIB0014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

  <!-- The COM-free helpers the fixtures are built on. TestPorts is what lets the
       simulators be pointed at another host and other ports. -->
  <ItemGroup>
    <Compile Include="..\RegressionTests\Shared\DeliveryFailedException.cs" Link="Shared\DeliveryFailedException.cs" />
    <Compile Include="..\RegressionTests\Shared\ExceptionPolicy.cs" Link="Shared\ExceptionPolicy.cs" />
    <Compile Include="..\RegressionTests\Shared\IMAPClientSimulator.cs" Link="Shared\IMAPClientSimulator.cs" />
    <Compile Include="..\RegressionTests\Shared\Paths.cs" Link="Shared\Paths.cs" />
    <Compile Include="..\RegressionTests\Shared\POP3ClientSimulator.cs" Link="Shared\POP3ClientSimulator.cs" />
    <Compile Include="..\RegressionTests\Shared\RetryableAssert.cs" Link="Shared\RetryableAssert.cs" />
    <Compile Include="..\RegressionTests\Shared\SMTPClientSimulator.cs" Link="Shared\SMTPClientSimulator.cs" />
    <Compile Include="..\RegressionTests\Shared\SMTPServerSimulator.cs" Link="Shared\SMTPServerSimulator.cs" />
    <Compile Include="..\RegressionTests\Shared\SslVersions.cs" Link="Shared\SslVersions.cs" />
    <Compile Include="..\RegressionTests\Shared\StringExtensions.cs" Link="Shared\StringExtensions.cs" />
    <Compile Include="..\RegressionTests\Shared\TcpConnection.cs" Link="Shared\TcpConnection.cs" />
    <Compile Include="..\RegressionTests\Shared\TcpServer.cs" Link="Shared\TcpServer.cs" />
    <Compile Include="..\RegressionTests\Shared\TestPorts.cs" Link="Shared\TestPorts.cs" />
    <Compile Include="..\RegressionTests\Shared\TestTracer.cs" Link="Shared\TestTracer.cs" />
    <Compile Include="..\RegressionTests\ExternalAccounts\ScriptedImapServer.cs" Link="ExternalAccounts\ScriptedImapServer.cs" />
    <Compile Include="..\RegressionTests\ExternalAccounts\ScriptedPop3Server.cs" Link="ExternalAccounts\ScriptedPop3Server.cs" />
    <Compile Include="..\RegressionTests\Infrastructure\RetryHelper.cs" Link="Infrastructure\RetryHelper.cs" />
    <Compile Include="..\RegressionTests\Infrastructure\SpamdSimulator.cs" Link="Infrastructure\SpamdSimulator.cs" />
  </ItemGroup>

  <!-- The fixtures: the socket-only ones first, then those that also need the test
       domain and accounts in it. -->
  <ItemGroup>
    <Compile Include="..\RegressionTests\API\StatusTests.cs" Link="API\StatusTests.cs" />
    <Compile Include="..\RegressionTests\Infrastructure\DnsResolution.cs" Link="Infrastructure\DnsResolution.cs" />
    <Compile Include="..\RegressionTests\SMTP\ESmtpTests.cs" Link="SMTP\ESmtpTests.cs" />
    <Compile Include="..\RegressionTests\SMTP\MailFromParsing.cs" Link="SMTP\MailFromParsing.cs" />
    <Compile Include="..\RegressionTests\SMTP\RcptToParsing.cs" Link="SMTP\RcptToParsing.cs" />
    <Compile Include="..\RegressionTests\SMTP\StartTlsAlreadyActive.cs" Link="SMTP\StartTlsAlreadyActive.cs" />
    <Compile Include="..\RegressionTests\Sieve\SieveEvaluation.cs" Link="Sieve\SieveEvaluation.cs" />
    <Compile Include="..\RegressionTests\Sieve\SieveExtensionActions.cs" Link="Sieve\SieveExtensionActions.cs" />
    <Compile Include="..\RegressionTests\Sieve\SieveExtensionRequire.cs" Link="Sieve\SieveExtensionRequire.cs" />
    <Compile Include="..\RegressionTests\Sieve\SieveSyntax.cs" Link="Sieve\SieveSyntax.cs" />
    <Compile Include="..\RegressionTests\Sieve\SieveVacation.cs" Link="Sieve\SieveVacation.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RegressionTests\API\Messages.cs" Link="API\Messages.cs" />
    <Compile Include="..\RegressionTests\AntiSpam\DKIM\ArcInboundFiltering.cs" Link="AntiSpam\DKIM\ArcInboundFiltering.cs" />
    <Compile Include="..\RegressionTests\AntiSpam\DKIM\Verification.cs" Link="AntiSpam\DKIM\Verification.cs" />
    <Compile Include="..\RegressionTests\IMAP\AppendInternalDate.cs" Link="IMAP\AppendInternalDate.cs" />
    <Compile Include="..\RegressionTests\IMAP\Binary.cs" Link="IMAP\Binary.cs" />
    <Compile Include="..\RegressionTests\IMAP\CommandSequences.cs" Link="IMAP\CommandSequences.cs" />
    <Compile Include="..\RegressionTests\IMAP\ConcurrentConnections.cs" Link="IMAP\ConcurrentConnections.cs" />
    <Compile Include="..\RegressionTests\IMAP\Examine.cs" Link="IMAP\Examine.cs" />
    <Compile Include="..\RegressionTests\IMAP\HierarchyDelimiter.cs" Link="IMAP\HierarchyDelimiter.cs" />
    <Compile Include="..\RegressionTests\IMAP\ListStatus.cs" Link="IMAP\ListStatus.cs" />
    <Compile Include="..\RegressionTests\IMAP\Metadata.cs" Link="IMAP\Metadata.cs" />
    <Compile Include="..\RegressionTests\IMAP\NonSynchronizingLiterals.cs" Link="IMAP\NonSynchronizingLiterals.cs" />
    <Compile Include="..\RegressionTests\IMAP\ObjectId.cs" Link="IMAP\ObjectId.cs" />
    <Compile Include="..\RegressionTests\IMAP\PartialFetchChunking.cs" Link="IMAP\PartialFetchChunking.cs" />
    <Compile Include="..\RegressionTests\IMAP\Preview.cs" Link="IMAP\Preview.cs" />
    <Compile Include="..\RegressionTests\IMAP\SaveDate.cs" Link="IMAP\SaveDate.cs" />
    <Compile Include="..\RegressionTests\IMAP\Search.cs" Link="IMAP\Search.cs" />
    <Compile Include="..\RegressionTests\IMAP\ThreadCommand.cs" Link="IMAP\ThreadCommand.cs" />
    <Compile Include="..\RegressionTests\IMAP\Unauthenticate.cs" Link="IMAP\Unauthenticate.cs" />
    <Compile Include="..\RegressionTests\IMAP\Utf8Append.cs" Link="IMAP\Utf8Append.cs" />
    <Compile Include="..\RegressionTests\Infrastructure\AccountProperties.cs" Link="Infrastructure\AccountProperties.cs" />
    <Compile Include="..\RegressionTests\Infrastructure\Persistence\AccountNameValidation.cs" Link="Infrastructure\Persistence\AccountNameValidation.cs" />
    <Compile Include="..\RegressionTests\Infrastructure\Persistence\AliasNameValidation.cs" Link="Infrastructure\Persistence\AliasNameValidation.cs" />
    <Compile Include="..\RegressionTests\MIME\MessageParsing.cs" Link="MIME\MessageParsing.cs" />
    <Compile Include="..\RegressionTests\MIME\Parameters.cs" Link="MIME\Parameters.cs" />
    <Compile Include="..\RegressionTests\POP3\AuthRespCode.cs" Link="POP3\AuthRespCode.cs" />
    <Compile Include="..\RegressionTests\POP3\Pipelining.cs" Link="POP3\Pipelining.cs" />
    <Compile Include="..\RegressionTests\SMTP\Bdat.cs" Link="SMTP\Bdat.cs" />
    <Compile Include="..\RegressionTests\SMTP\BinaryMime.cs" Link="SMTP\BinaryMime.cs" />
    <Compile Include="..\RegressionTests\SMTP\Deliverability.cs" Link="SMTP\Deliverability.cs" />
    <Compile Include="..\RegressionTests\SMTP\OutboundSize.cs" Link="SMTP\OutboundSize.cs" />
    <Compile Include="..\RegressionTests\SMTP\ReceivedHeaders.cs" Link="SMTP\ReceivedHeaders.cs" />
    <Compile Include="..\RegressionTests\SMTP\RecipientVerification.cs" Link="SMTP\RecipientVerification.cs" />
    <Compile Include="..\RegressionTests\SSL\SmtpDeliverySslTests.cs" Link="SSL\SmtpDeliverySslTests.cs" />
    <Compile Include="..\RegressionTests\SSL\SslTlsVersionTests.cs" Link="SSL\SslTlsVersionTests.cs" />
    <Compile Include="..\RegressionTests\SSL\TlsOptionsTests.cs" Link="SSL\TlsOptionsTests.cs" />
    <Compile Include="..\RegressionTests\Security\Basics.cs" Link="Security\Basics.cs" />
    <!-- Security\ProtocolFuzz.cs is deliberately not here: its three tests carry
         [Timeout(180000)], which NUnit 4 on .NET refuses before any SetUp runs
         ("TargetFramework doesn't support timeout on tests"), as an error rather
         than a skip. It drives the server over plain sockets and would otherwise
         belong; it comes back when the attribute goes. -->
    <Compile Include="..\RegressionTests\Sieve\SieveAccountScript.cs" Link="Sieve\SieveAccountScript.cs" />
    <Compile Include="..\RegressionTests\Sieve\SieveEditheaderDelivery.cs" Link="Sieve\SieveEditheaderDelivery.cs" />
    <Compile Include="..\RegressionTests\Stress\IMAP\NotificationThreadingStressTests.cs" Link="Stress\IMAP\NotificationThreadingStressTests.cs" />
  </ItemGroup>

  <!-- The embedded messages, under the manifest names the Windows assembly gives
       them (TestSetup.GetResource adds the RegressionTests. prefix), and the two
       DKIM messages that Shims\TestResources.cs serves in place of the Windows
       project's TestResources.resx, whose file references do not match the files'
       case and so cannot be compiled on Linux. -->
  <ItemGroup>
    <EmbeddedResource Include="..\RegressionTests\Messages\*.txt" Link="Messages\%(Filename)%(Extension)" LogicalName="RegressionTests.Messages.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\RegressionTests\Resources\MessageWithInvalidDkim.eml" Link="Resources\MessageWithInvalidDkim.eml" LogicalName="RegressionTests.Resources.MessageWithInvalidDkim.eml" />
    <EmbeddedResource Include="..\RegressionTests\Resources\MessageWithValidDkim.eml" Link="Resources\MessageWithValidDkim.eml" LogicalName="RegressionTests.Resources.MessageWithValidDkim.eml" />
  </ItemGroup>

</Project>
