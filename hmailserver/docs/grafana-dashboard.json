{
  "__comment": "hMailServer Grafana dashboard. Built against the metric names MetricsServer.cpp actually emits - verified by grep, not assumed. Import via Dashboards > New > Import and pick your Prometheus datasource. Series colours were validated computationally for colour-blind separation, lightness band, chroma and contrast against BOTH light and dark chart surfaces (Grafana panel JSON allows only one fixed colour per series, so each set has to pass in both). Every multi-series panel carries a legend, so identity is never colour alone.",
  "title": "hMailServer",
  "uid": "hmailserver-overview",
  "tags": ["hmailserver", "mail"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(hmailserver_build_info, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "label": "Instance"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Server state",
      "description": "OpenMetrics StateSet: one series per state, so the running state is a boolean rather than a magic number. Shows the name of whichever state is 1.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "hmailserver_state{instance=~\"$instance\"} == 1",
          "legendFormat": "{{state}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "—", "index": 0 } } }
          ],
          "color": { "mode": "fixed", "fixedColor": "#199e70" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Database",
      "description": "hmailserver_database_connected. Named _connected rather than _up so it cannot be confused with Prometheus's own synthetic up series - a scrape failure and a database failure are different incidents.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 1 },
      "targets": [
        { "expr": "hmailserver_database_connected{instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "#e34948", "index": 0 }, "1": { "text": "Connected", "color": "#199e70", "index": 1 } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "No data", "color": "#c98500", "index": 2 } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "description": "Derived from hmailserver_start_time_seconds, a Unix timestamp following the process_start_time_seconds convention. A restart is visible as changes(hmailserver_start_time_seconds[1h]) rather than as a silent reset to zero.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 1 },
      "targets": [
        { "expr": "time() - hmailserver_start_time_seconds{instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 } },
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "Missing message files",
      "description": "Anything above zero means the database references a message file that is not on disk. This is the panel to alert on.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 1 },
      "targets": [
        { "expr": "hmailserver_messagestore_missing_files{instance=~\"$instance\"}", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#199e70", "value": null }, { "color": "#e34948", "value": 1 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "TLS certificate expiry",
      "description": "hmailserver_tls_certificate_expiry_seconds as a Unix timestamp, per certificate. Renewal is automatic when ACME is enabled, so this panel exists to catch renewal having silently stopped. Amber inside 21 days, red inside 7.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "targets": [
        { "expr": "min by (name) (hmailserver_tls_certificate_expiry_seconds{instance=~\"$instance\"} - time())", "legendFormat": "{{name}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#e34948", "value": null }, { "color": "#c98500", "value": 604800 }, { "color": "#199e70", "value": 1814400 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "Mail flow",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Delivery outcomes",
      "description": "Delivered, deferred and bounced per second. Stacked deliberately: these are outcomes of one population and genuinely sum to the total attempted.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum(rate(hmailserver_messages_delivered_total{instance=~\"$instance\"}[5m]))", "legendFormat": "delivered", "refId": "A" },
        { "expr": "sum(rate(hmailserver_messages_deferred_total{instance=~\"$instance\"}[5m]))", "legendFormat": "deferred", "refId": "B" },
        { "expr": "sum(rate(hmailserver_messages_bounced_total{instance=~\"$instance\"}[5m]))", "legendFormat": "bounced", "refId": "C" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 1, "fillOpacity": 35, "stacking": { "mode": "normal" }, "lineInterpolation": "linear", "showPoints": "never", "gradientMode": "none" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "delivered" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "deferred" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "bounced" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#e34948" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Delivery queue: depth and oldest message",
      "description": "Two series, both in the queue's own terms. Depth alone cannot distinguish a burst from a stuck relay - a small queue whose oldest message keeps ageing is the shape of a destination that is not accepting mail. Oldest age is plotted on the right axis in seconds because the two share no scale; that is a deliberate exception to the one-axis rule and the only one in this dashboard.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "sum(hmailserver_delivery_queue_messages{instance=~\"$instance\"})", "legendFormat": "queued messages", "refId": "A" },
        { "expr": "max(hmailserver_delivery_queue_oldest_message_age_seconds{instance=~\"$instance\"})", "legendFormat": "oldest message age", "refId": "B" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10, "lineInterpolation": "linear", "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "queued messages" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }, { "id": "unit", "value": "short" }] },
          { "matcher": { "id": "byName", "options": "oldest message age" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }, { "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Messages processed, spam blocked, viruses removed",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "sum(rate(hmailserver_processed_messages_total{instance=~\"$instance\"}[5m]))", "legendFormat": "processed", "refId": "A" },
        { "expr": "sum(rate(hmailserver_spam_messages_total{instance=~\"$instance\"}[5m]))", "legendFormat": "spam blocked", "refId": "B" },
        { "expr": "sum(rate(hmailserver_viruses_removed_total{instance=~\"$instance\"}[5m]))", "legendFormat": "viruses removed", "refId": "C" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 0, "lineInterpolation": "linear", "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "processed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "spam blocked" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "viruses removed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Active sessions",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "hmailserver_sessions{instance=~\"$instance\"}", "legendFormat": "{{protocol}}", "refId": "A" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10, "lineInterpolation": "linear", "showPoints": "never" } } }
    },
    {
      "type": "row",
      "title": "Authentication and TLS",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Authentication outcomes",
      "description": "A sustained rise in failures against flat successes is the shape of a credential-stuffing run. Counters are global - there are no per-domain or per-account labels yet.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        { "expr": "sum(rate(hmailserver_auth_success_total{instance=~\"$instance\"}[5m]))", "legendFormat": "success", "refId": "A" },
        { "expr": "sum(rate(hmailserver_auth_failures_total{instance=~\"$instance\"}[5m]))", "legendFormat": "failure", "refId": "B" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10, "lineInterpolation": "linear", "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "failure" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#e34948" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "TLS handshakes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        { "expr": "sum(rate(hmailserver_tls_handshakes_total{instance=~\"$instance\"}[5m]))", "legendFormat": "completed", "refId": "A" },
        { "expr": "sum(rate(hmailserver_tls_handshake_failures_total{instance=~\"$instance\"}[5m]))", "legendFormat": "failed", "refId": "B" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10, "lineInterpolation": "linear", "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "completed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#e34948" } }] }
        ]
      }
    },
    {
      "type": "row",
      "title": "Latency and database",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Command processing latency",
      "description": "Real quantiles, from histogram buckets. These metrics were previously Prometheus summaries carrying only _sum and _count, so only a mean was computable - the least useful latency statistic. p99 is the one that corresponds to a user noticing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(hmailserver_command_processing_seconds_bucket{instance=~\"$instance\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(hmailserver_command_processing_seconds_bucket{instance=~\"$instance\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(hmailserver_command_processing_seconds_bucket{instance=~\"$instance\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 0, "lineInterpolation": "linear", "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#e34948" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Database query latency",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(hmailserver_db_query_seconds_bucket{instance=~\"$instance\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(hmailserver_db_query_seconds_bucket{instance=~\"$instance\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(hmailserver_db_query_seconds_bucket{instance=~\"$instance\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 0, "lineInterpolation": "linear", "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#e34948" } }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Database connection pool",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 40 },
      "targets": [
        { "expr": "hmailserver_db_connections{instance=~\"$instance\"}", "legendFormat": "{{state}}", "refId": "A" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10, "lineInterpolation": "linear", "showPoints": "never" } } }
    },
    {
      "type": "timeseries",
      "title": "Slow queries",
      "description": "Separated from the pool panel on purpose: a rate per second and a connection count share no scale, and putting them on one axis manufactures a correlation that is not in the data.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 40 },
      "targets": [
        { "expr": "sum(rate(hmailserver_db_slow_queries_total{instance=~\"$instance\"}[5m]))", "legendFormat": "slow queries", "refId": "A" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false } },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "fixed", "fixedColor": "#d95926" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "lineInterpolation": "linear", "showPoints": "never" }
        }
      }
    }
  ]
}
