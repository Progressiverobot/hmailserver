#
# The systemd unit. On Windows the server registers itself with the Service
# Control Manager from inside its own process; here the supervisor is declared
# rather than programmed, and this file is the whole of that declaration.
#
# platform/main.cpp is written to suit it: it does not fork, does not write a pid
# file, runs until SIGTERM or SIGINT, and re-reads its configuration on SIGHUP.
#
# A drop-in is the right way to change any of this on a particular machine -
# systemctl edit hmailserver - because an upgrade replaces this file and a
# drop-in survives it.

[Unit]
Description=hMailServer, a mail server for SMTP, IMAP and POP3
Documentation=https://github.com/Progressiverobot/hmailserver
Documentation=file:/etc/hmailserver/hMailServer.ini

# network-online rather than network: a listener binds an explicit address
# whenever one of the BindAddress settings is something other than 0.0.0.0, and a
# bind to an address the machine does not have yet fails outright rather than
# waiting. Wants= is what actually pulls the target in; After= on its own orders
# against a target nothing has asked for, which on most machines means no wait.
Wants=network-online.target
After=network-online.target

# The database, when it is on this machine. After= only, and deliberately not
# Requires= or Wants=: the backend is as often on another host, where no local
# unit can express the dependency, and a hard requirement on a unit that is not
# installed would refuse to start the server at all. Naming an absent unit in
# After= is a no-op, so all four can be listed. The server survives a database
# that is not up yet in any case - it retries ConnectionAttempts times,
# ConnectionAttemptsDelay seconds apart.
After=postgresql.service mariadb.service mysql.service mysqld.service

[Service]
Type=simple
ExecStart=/usr/bin/hmailserver --foreground
User=hmailserver
Group=hmailserver

# SIGHUP is Application::Reinitialize, which is the Control Panel's Reinitialize:
# it stops the listeners, re-reads the configuration and starts them again inside
# the running process. That is a real interruption - sessions in flight are
# dropped - so it is offered as reload rather than being something the unit does
# on its own, and log rotation deliberately does NOT use it (see
# hmailserver.logrotate).
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5

# Long enough to drain. A mail server killed mid-delivery leaves the remote end
# to retry a message it may already have accepted, so the stop is given room. The
# server's own ShutdownDrainSeconds decides how long it waits for active sessions
# to finish; this value must be comfortably larger than that one. Raise both
# together, never just one.
TimeoutStopSec=300

# The message store lives here, and in a stock configuration the process writes
# nothing outside these two directories. ArchiveDir, the ACME certificate
# directory and a backup destination are all administrator-chosen and may sit
# elsewhere: a path outside this list is read-only to the service and the write
# fails, so add it with a drop-in when you set one.
WorkingDirectory=/var/lib/hmailserver
ReadWritePaths=/var/lib/hmailserver /var/log/hmailserver

# Ports 25, 110, 143, 465, 587, 993 and 995 are all below 1024 and the process
# never runs as root, so the one capability it needs is granted ambiently and the
# bounding set is emptied of everything else. Ambient capabilities survive
# NoNewPrivileges, which is why both can be set.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# /usr and /boot read-only, /etc read-only, everything under /var read-only
# except the two paths above. /etc/hmailserver is deliberately on the read-only
# side: the only code that writes hMailServer.INI is the COM administration API,
# which is not part of this build, so a configuration this service could rewrite
# would be a privilege nothing here uses.
ProtectSystem=strict
ProtectHome=yes

# The server's own temporary files go to TempFolder under /var/lib/hmailserver
# rather than to /tmp, so a private /tmp costs nothing. The exception is a Custom
# or ClamWin scanner, which hands a path to an external program: a helper started
# outside this unit cannot see into a private /tmp. clamd is unaffected - it is
# reached over TCP and the message is streamed to it with INSTREAM, never shared
# through the filesystem.
PrivateTmp=yes
PrivateDevices=yes

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# /proc/self/exe is the only thing under /proc this program reads - it is how
# Application::GetExecutableName finds the installation directory, and therefore
# how hMailServer.INI is found at all. Both settings below leave a process's own
# entries alone, so that lookup keeps working.
ProtectProc=invisible
ProcSubset=pid

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes

# AF_INET and AF_INET6 are the protocols; AF_UNIX is what syslog and the name
# service switch use; AF_NETLINK is what glibc's getaddrinfo uses to enumerate
# local addresses, and without it name resolution degrades in ways that are hard
# to attribute afterwards. AF_PACKET and the rest have no business here.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# 0027: a message file is readable by the group and by nobody else. The mail
# store holds other people's mail and the log files hold their addresses.
UMask=0027

# One connection is one descriptor, and so is every open message file and
# database connection. The usual 1024 is reached by a few hundred concurrent
# IMAP sessions, and what happens then is accept() failing on a healthy server.
LimitNOFILE=65535

# --------------------------------------------------------------------------
# Deliberately NOT enabled, each for a reason rather than an oversight.
#
# DynamicUser=yes
#   The mail store is the point of this program and it outlives every version of
#   it. A user id allocated afresh on each start would leave the store owned by a
#   user that no longer exists.
#
# PrivateUsers=yes
#   It puts the service in a user namespace, where CAP_NET_BIND_SERVICE applies
#   to that namespace and not to the host's ports. The server would then be
#   unable to bind 25, which is the one port it cannot do without.
#
# MemoryDenyWriteExecute=yes
#   Not verified against this program. The MySQL/MariaDB client is loaded at run
#   time with dlopen (MySQLInterface.cpp), and an unverified W^X policy that
#   breaks the database client breaks the server. Turn it on once a build has run
#   against a MariaDB backend with it set; it is very likely safe, which is not
#   the same as being known to be.
#
# StateDirectory=hmailserver / LogsDirectory=hmailserver
#   They would create and own /var/lib/hmailserver and /var/log/hmailserver. The
#   package creates them instead, so that removing the package - and nothing else
#   - decides what happens to a mail store.
#
# IPAddressDeny=any with an allow list
#   An MTA talks to every mail server on the internet, inbound and outbound.
#   There is no list to write.
#
# PrivateNetwork=yes
#   Stated only because it appears on every hardening list: a mail server with no
#   network is not a mail server.

[Install]
WantedBy=multi-user.target
