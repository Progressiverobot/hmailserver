<UserControl
    x:Class="hMailServer.ControlPanel.Views.TcpIpPortsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!-- The listener summary: only as tall as what it has to say, and
                 collapsed entirely when every port is up. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="TCP/IP ports" Style="{StaticResource PageTitle}" />
            <TextBlock Text="The ports each protocol listens on, their bind address and connection security. The service must be restarted after changes. The Listening column is read from this machine's open ports, not from the configuration, so it shows what is actually happening rather than what was asked for."
                       Style="{StaticResource PageSubtitle}" />
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Search ports..." Width="300"
                        HorizontalAlignment="Left" Margin="0,10,0,0" TextChanged="Search_TextChanged"
                        AutomationProperties.Name="Search ports">
                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
            </ui:TextBox>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
            <DataGrid x:Name="PortGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0" RowHeight="34"
                      SelectionMode="Single" MouseDoubleClick="Edit_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="120" />
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="170" />
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Security" Binding="{Binding Security}" Width="180" />
                    <!-- A shape as well as a word, so the difference between a live
                         port and a dead one survives greyscale, colour blindness and
                         High Contrast. The mark itself is built in the code-behind by
                         ShapeMarkVisuals.ApplyMark and hosted here: a Path bound
                         straight to Fill would render a stroke-only mark as nothing
                         at all, which is precisely the silent failure that helper
                         exists to prevent. -->
                    <DataGridTemplateColumn Header="Listening" Width="150" SortMemberPath="ListeningWord">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding ListeningTip}">
                                    <ContentPresenter Content="{Binding ListeningMark}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ListeningWord}" VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding ListeningTip}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Certificate" Binding="{Binding Certificate}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyStatus" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <TextBlock x:Name="ListenerSummary" Grid.Row="2"
                   Margin="2,10,2,0" FontSize="12.5" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Add port" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="NewProtocol" SelectedIndex="0" Margin="0,0,8,0">
                        <ComboBoxItem Content="SMTP" />
                        <ComboBoxItem Content="POP3" />
                        <ComboBoxItem Content="IMAP" />
                    </ComboBox>
                    <ui:TextBox x:Name="NewAddress" Grid.Column="1" PlaceholderText="Bind address (0.0.0.0)" Text="0.0.0.0" Margin="0,0,8,0" />
                    <ui:TextBox x:Name="NewPort" Grid.Column="2" PlaceholderText="Port" Margin="0,0,8,0" />
                    <ComboBox x:Name="NewSecurity" Grid.Column="3" SelectedIndex="0" Margin="0,0,8,0">
                        <ComboBoxItem Content="None" />
                        <ComboBoxItem Content="SSL/TLS" />
                        <ComboBoxItem Content="STARTTLS (optional)" />
                        <ComboBoxItem Content="STARTTLS (required)" />
                    </ComboBox>
                    <ui:Button Grid.Column="4" Content="Add" Appearance="Primary" Click="Add_Click" Margin="0,0,8,0" />
                    <ui:Button Grid.Column="5" Content="Properties" Click="Edit_Click" Margin="0,0,8,0" />
                    <ui:Button Grid.Column="6" Content="Delete selected" Appearance="Secondary"
                               Foreground="{DynamicResource AppDangerBrush}" Click="Delete_Click" Margin="0,0,8,0" />
                    <ui:Button Grid.Column="7" Content="Restore defaults" Click="RestoreDefaults_Click"
                               ToolTip="Replaces every port with the standard set: SMTP 25 and 587, POP3 110, IMAP 143, all without connection security." />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
