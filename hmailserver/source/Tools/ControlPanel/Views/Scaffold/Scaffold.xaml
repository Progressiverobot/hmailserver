<!-- The scaffold components' templates, as implicit styles keyed by type, and
     the grid styles. Merged into App.xaml; the tokens come along through the
     merge below so that this file can reference them statically. Anything from
     the theme (TextFillColor*, SubtleFill*, ControlElevation*) or republished
     by ThemeTokens (App*Brush) is a DynamicResource, because it changes with the
     theme; a token that never changes (a size, a radius) is a StaticResource. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/hMailCP;component/Views/Scaffold/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- PageHeader: title (and an optional pill beside it), subtitle, actions on the right. -->
    <Style TargetType="{x:Type scaffold:PageHeader}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="{StaticResource AppHeaderGap}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scaffold:PageHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PART_Title" Text="{TemplateBinding Title}"
                                           Style="{StaticResource TextTitle}" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="PART_Status" Content="{TemplateBinding Status}"
                                                  Margin="12,6,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="PART_Subtitle" Text="{TemplateBinding Subtitle}"
                                       Style="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,6,0,0"
                                    VerticalAlignment="Top" HorizontalAlignment="Right">
                            <!-- The page's tour, where it has one. Before the
                                 page's own actions because it is not one of
                                 them: it teaches the page rather than changing
                                 anything on it. Collapsed on a page no tour
                                 visits - a help button that opens an apology is
                                 worse than no help button. -->
                            <ui:Button x:Name="PART_Help" Appearance="Transparent" Padding="8,6"
                                       Margin="0,0,8,0" Visibility="Collapsed"
                                       Icon="{ui:SymbolIcon QuestionCircle24}" />
                            <ContentPresenter x:Name="PART_Actions" Content="{TemplateBinding Actions}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="PART_Subtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Null}">
                            <Setter TargetName="PART_Status" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Actions" Value="{x:Null}">
                            <Setter TargetName="PART_Actions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card: the surface, with an optional title, description and footer. -->
    <Style TargetType="{x:Type scaffold:Card}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="{StaticResource AppCardPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scaffold:Card}">
                    <Border Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderBrush="{DynamicResource AppCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppCardCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PART_Title" Text="{TemplateBinding Title}"
                                       Style="{StaticResource TextBodyStrong}" Margin="0,0,0,4" />
                            <TextBlock x:Name="PART_Description" Grid.Row="1" Text="{TemplateBinding Description}"
                                       Style="{StaticResource TextCaption}" Margin="0,0,0,10" />
                            <ContentPresenter Grid.Row="2"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border x:Name="PART_Footer" Grid.Row="3" Margin="0,12,0,0" Padding="0,10,0,0"
                                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppDividerBrush}">
                                <ContentPresenter Content="{TemplateBinding Footer}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="PART_Footer" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar: search, filters, actions. -->
    <Style TargetType="{x:Type scaffold:Toolbar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="{StaticResource AppCardGap}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scaffold:Toolbar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="PART_Search"
                                    Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{TemplateBinding SearchPlaceholder}"
                                    AutomationProperties.Name="{TemplateBinding SearchPlaceholder}"
                                    ClearButtonEnabled="True"
                                    MinWidth="220" MaxWidth="360" VerticalAlignment="Center" />
                        <ContentPresenter x:Name="PART_Filters" Grid.Column="1" Content="{TemplateBinding Filters}"
                                          Margin="12,0,0,0" VerticalAlignment="Center" />
                        <ContentPresenter x:Name="PART_Actions" Grid.Column="3" Content="{TemplateBinding Actions}"
                                          Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowSearch" Value="False">
                            <Setter TargetName="PART_Search" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Filters" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Filters" Value="{x:Null}">
                            <Setter TargetName="PART_Filters" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Actions" Value="{x:Null}">
                            <Setter TargetName="PART_Actions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EmptyState: glyph, one sentence, an action; centred where the rows would be. -->
    <Style TargetType="{x:Type scaffold:EmptyState}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scaffold:EmptyState}">
                    <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center">
                        <ui:SymbolIcon x:Name="PART_Icon" Symbol="{TemplateBinding Icon}" FontSize="40"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock x:Name="PART_Text" Text="{TemplateBinding Text}" Style="{StaticResource TextSecondary}"
                                   TextAlignment="Center" MaxWidth="440" HorizontalAlignment="Center" />
                        <ContentPresenter x:Name="PART_Action" Content="{TemplateBinding Action}"
                                          HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="Empty">
                            <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Action" Value="{x:Null}">
                            <Setter TargetName="PART_Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LoadingState: a ring and a line, centred. -->
    <Style TargetType="{x:Type scaffold:LoadingState}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scaffold:LoadingState}">
                    <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Center" />
                        <TextBlock Text="{TemplateBinding Text}" Style="{StaticResource TextSecondary}"
                                   TextAlignment="Center" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- InlineNotice: a tinted, outlined row with the mark, the severity word,
         the sentence and an optional action. The brushes are set by the class
         from the level's resource key. -->
    <Style TargetType="{x:Type scaffold:InlineNotice}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="{StaticResource AppCardGap}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scaffold:InlineNotice}">
                    <Grid>
                        <Border x:Name="PART_Tint" CornerRadius="{StaticResource AppControlCornerRadius}"
                                Opacity="{DynamicResource AppNoticeTintOpacity}" />
                        <Border x:Name="PART_Frame" CornerRadius="{StaticResource AppControlCornerRadius}"
                                BorderThickness="1" Padding="12,8" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="PART_Mark" Width="11" Height="11" Stretch="Fill"
                                      Margin="0,4,8,0" VerticalAlignment="Top" />
                                <TextBlock x:Name="PART_Word" Grid.Column="1" FontSize="{StaticResource AppFontSizeBody}"
                                           FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding Text}" Style="{StaticResource TextBody}"
                                           VerticalAlignment="Top" />
                                <ContentPresenter Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StatusPill: mark and word in a capsule outlined in the level's colour. -->
    <Style TargetType="{x:Type scaffold:StatusPill}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scaffold:StatusPill}">
                    <Border x:Name="PART_Frame" CornerRadius="{StaticResource AppPillCornerRadius}"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderThickness="1" Padding="9,2,10,3" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PART_Mark" Width="8" Height="8" Stretch="Fill"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PART_Text" Text="{TemplateBinding Text}"
                                       FontSize="{StaticResource AppFontSizeCaption}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- FieldRow: caption, editor, hint, message. -->
    <Style TargetType="{x:Type scaffold:FieldRow}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="{StaticResource AppFieldGap}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scaffold:FieldRow}">
                    <StackPanel>
                        <TextBlock x:Name="PART_Label" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <TextBlock x:Name="PART_Hint" Text="{TemplateBinding Hint}"
                                   Style="{StaticResource TextCaptionTertiary}" Margin="0,4,0,0" />
                        <Grid x:Name="PART_ErrorRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="PART_ErrorMark" Width="9" Height="9" Stretch="Fill"
                                  Margin="1,3,7,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="PART_Error" Grid.Column="1" Text="{TemplateBinding Error}"
                                       FontSize="{StaticResource AppFontSizeCaption}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppDangerBrush}"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Hint" Value="{x:Null}">
                            <Setter TargetName="PART_Hint" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Error" Value="{x:Null}">
                            <Setter TargetName="PART_ErrorRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SettingsSection: heading, description, fields. -->
    <Style TargetType="{x:Type scaffold:SettingsSection}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="{StaticResource AppSectionGap}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scaffold:SettingsSection}">
                    <StackPanel>
                        <TextBlock x:Name="PART_Heading" Text="{TemplateBinding Heading}"
                                   Style="{StaticResource TextBodyStrong}" />
                        <TextBlock x:Name="PART_Description" Text="{TemplateBinding Description}"
                                   Style="{StaticResource TextCaption}" MaxWidth="720" HorizontalAlignment="Left"
                                   Margin="0,2,0,0" />
                        <ContentPresenter Margin="0,10,0,0"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Heading" Value="{x:Null}">
                            <Setter TargetName="PART_Heading" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DialogFrame: heading, scrolling body, footer with the primary button first. -->
    <Style TargetType="{x:Type scaffold:DialogFrame}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="24,20,24,20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scaffold:DialogFrame}">
                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock x:Name="PART_Heading" Text="{TemplateBinding Heading}"
                                       Style="{StaticResource TextSubtitle}" />
                            <TextBlock x:Name="PART_Description" Text="{TemplateBinding Description}"
                                       Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ContentPresenter Content="{TemplateBinding Body}" />
                        </ScrollViewer>
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="PART_Footer" Content="{TemplateBinding Footer}"
                                              VerticalAlignment="Center" />
                            <ContentPresenter x:Name="PART_Primary" Grid.Column="1" Content="{TemplateBinding PrimaryButton}"
                                              Margin="8,0,0,0" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="PART_Secondary" Grid.Column="2" Content="{TemplateBinding SecondaryButton}"
                                              Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Heading" Value="{x:Null}">
                            <Setter TargetName="PART_Heading" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="PART_Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="PART_Footer" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="PrimaryButton" Value="{x:Null}">
                            <Setter TargetName="PART_Primary" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SecondaryButton" Value="{x:Null}">
                            <Setter TargetName="PART_Secondary" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grids: a right-aligned column for numbers. The grid itself, its rows,
         cells and headers are styled implicitly in App.xaml, where the DataGrid
         style can chain to the theme's own. -->
    <Style x:Key="GridNumberText" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
</ResourceDictionary>
