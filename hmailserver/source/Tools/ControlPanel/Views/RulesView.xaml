<UserControl
    x:Class="hMailServer.ControlPanel.Views.RulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.3*" />
        </Grid.RowDefinitions>

        <!-- HeaderPanel is collapsed when the view is embedded in the account
             dialog (ConfigureForRules), where the tab names the page. -->
        <scaffold:PageHeader x:Name="HeaderPanel" Title="{loc:L 'Global rules'}"
                             Subtitle="{loc:L 'Server-wide message rules, evaluated top to bottom.'}" />

        <scaffold:Toolbar x:Name="SearchBar" Grid.Row="1" SearchPlaceholder="{loc:L 'Search rules'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="MoveUpButton" Content="{loc:L 'Move _up'}" Click="MoveUp_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="MoveDownButton" Content="{loc:L 'Move _down'}" Click="MoveDown_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="ToggleButton" Content="{loc:L 'Ena_ble / disable'}" Click="Toggle_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="DeleteRuleButton" Content="{loc:L 'De_lete rule'}" Appearance="Danger" Click="Delete_Click" />
                </StackPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <scaffold:Card Grid.Row="2" Padding="8">
            <Grid>
                <DataGrid x:Name="RuleGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionChanged="RuleGrid_SelectionChanged"
                          AutomationProperties.Name="{loc:L 'Global rules'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="50"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn Header="{loc:L 'Name'}" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="{loc:L 'Enabled'}" Binding="{Binding Enabled}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="TextBulletListSquare24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </scaffold:Card>

        <!-- The add form, under the grid so the grid keeps the height. -->
        <scaffold:Card Grid.Row="3" Margin="0,12,0,12" Padding="20,12,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <scaffold:FieldRow Label="{loc:L 'New rule name'}" Margin="0,0,8,12">
                    <ui:TextBox x:Name="NewRuleName" />
                </scaffold:FieldRow>
                <ui:Button Grid.Column="1" Content="{loc:L '_Add rule'}" Appearance="Primary" Click="AddRule_Click"
                           VerticalAlignment="Bottom" Margin="0,0,0,12" />
            </Grid>
        </scaffold:Card>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Criteria -->
            <scaffold:Card Margin="0,0,6,0" AutomationProperties.Name="{loc:L 'IF'}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:L 'IF'}" Style="{StaticResource TextBodyStrong}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox x:Name="MatchMode" MinWidth="230"
                                  SelectionChanged="MatchMode_SelectionChanged" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="CriteriaGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="None"
                              SelectionMode="Single" MouseDoubleClick="EditCriterion_Click"
                              AutomationProperties.Name="{loc:L 'IF'}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                <scaffold:Card.Footer>
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="{loc:L 'Add _criterion…'}" Appearance="Primary" Click="AddCriterion_Click" Margin="0,0,8,0" />
                        <ui:Button x:Name="EditCriterionButton" Content="{loc:L '_Edit criterion…'}" Click="EditCriterion_Click" Margin="0,0,8,0" />
                        <ui:Button x:Name="RemoveCriterionButton" Content="{loc:L '_Remove criterion'}" Appearance="Danger" Click="RemoveCriterion_Click" />
                    </WrapPanel>
                </scaffold:Card.Footer>
            </scaffold:Card>

            <!-- Actions -->
            <scaffold:Card Grid.Column="1" Title="{loc:L 'THEN'}" Margin="6,0,0,0">
                <DataGrid x:Name="ActionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="None"
                          SelectionMode="Single" MouseDoubleClick="EditAction_Click"
                          AutomationProperties.Name="{loc:L 'THEN'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <scaffold:Card.Footer>
                    <!-- A WrapPanel, not a StackPanel: five buttons do not fit one row of
                         the half-width card at 1920 wide, and a StackPanel clips the last
                         one rather than wrapping it. -->
                    <WrapPanel Orientation="Horizontal">
                        <ui:Button Content="{loc:L 'Add ac_tion…'}" Appearance="Primary" Click="AddAction_Click" Margin="0,0,8,4" />
                        <ui:Button x:Name="EditActionButton" Content="{loc:L 'Ed_it action…'}" Click="EditAction_Click" Margin="0,0,8,4" />
                        <ui:Button x:Name="RemoveActionButton" Content="{loc:L 'Re_move action'}" Appearance="Danger" Click="RemoveAction_Click" Margin="0,0,8,4" />
                        <ui:Button x:Name="ActionUpButton" Content="U_p" Click="ActionUp_Click" Margin="0,0,8,4" />
                        <ui:Button x:Name="ActionDownButton" Content="{loc:L 'Dow_n'}" Click="ActionDown_Click" Margin="0,0,8,4" />
                    </WrapPanel>
                </scaffold:Card.Footer>
            </scaffold:Card>
        </Grid>
    </Grid>
</UserControl>
