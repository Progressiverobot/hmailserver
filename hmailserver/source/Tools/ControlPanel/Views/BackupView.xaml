<UserControl
    x:Class="hMailServer.ControlPanel.Views.BackupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20">
        <StackPanel>
            <TextBlock Text="Backup &amp; restore" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Text="Back up domains, messages and settings to a folder; restore from a previous backup."
                       Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Backup" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="Destination folder (on the server)" FontSize="13" Margin="0,0,0,4" />
                    <Grid Width="520" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="DestinationBox" Grid.Column="0" />
                        <ui:Button x:Name="BrowseDestination" Grid.Column="1" Content="…" MinWidth="40" Margin="8,0,0,0"
                                   VerticalAlignment="Bottom" ToolTip="Browse for a folder" Click="BrowseDestination_Click" />
                    </Grid>
                    <CheckBox x:Name="CheckDomains" Content="Back up domains (accounts, aliases, lists)" FontSize="13.5" Margin="0,0,0,12" />
                    <CheckBox x:Name="CheckMessages" Content="Back up messages" FontSize="13.5" Margin="0,0,0,8" />
                    <CheckBox x:Name="CheckMessagesDbOnly" Content="Message metadata only — do not copy the message files"
                              FontSize="13.5" Margin="22,0,0,4" />
                    <TextBlock x:Name="MessagesDbOnlyNote" MaxWidth="520" HorizontalAlignment="Left"
                               Text="hMailServer.ini setting BackupMessagesDBOnly. The backup then records which messages exist but not their contents, and a restore expects the files to still be in the data folder. Applies to backup and restore, after a service restart."
                               FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="22,0,0,12" />
                    <CheckBox x:Name="CheckSettings" Content="Back up settings" FontSize="13.5" Margin="0,0,0,12" />
                    <CheckBox x:Name="CheckCompress" Content="Compress destination files (zip)" FontSize="13.5" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Save settings" Click="SaveSettings_Click" Margin="0,0,8,0" />
                        <ui:Button Content="Start backup now" Appearance="Primary" Click="StartBackup_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Scheduled backups" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <!-- State first: whether a schedule exists and how old the newest archive is.
                         Colour, shape AND word (StatusSemantics), so no channel is load-bearing alone. -->
                    <Grid MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ScheduleMark" Width="11" Height="11" Stretch="Fill" Margin="0,4,8,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="ScheduleStatusText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" />
                    </Grid>
                    <Grid MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="LastBackupMark" Width="11" Height="11" Stretch="Fill" Margin="0,4,8,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="LastBackupStatusText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Text="Daily backup time (24-hour HH:MM, empty = off)" FontSize="13" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="ScheduleTimeBox" Width="200" HorizontalAlignment="Left"
                                AutomationProperties.Name="Daily backup time (24-hour HH:MM, empty = off)" />
                    <TextBlock MaxWidth="520" HorizontalAlignment="Left"
                               Text="At most one backup per calendar day, taken at the first check at or after this time (the server's local time). If an interval is also set below, the daily time wins."
                               FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,4,0,12" />

                    <TextBlock Text="Backup interval in minutes (0 = off)" FontSize="13" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="IntervalBox" Width="200" HorizontalAlignment="Left"
                                AutomationProperties.Name="Backup interval in minutes (0 = off)" />
                    <TextBlock MaxWidth="520" HorizontalAlignment="Left"
                               Text="Used when no daily time is set. The interval is measured against the newest archive in the destination, so it survives service restarts; if the destination holds no backup at all, the first one is taken about a minute after the service starts."
                               FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,4,0,12" />

                    <TextBlock Text="Retention" FontSize="13.5" FontWeight="SemiBold" Margin="0,2,0,8" />
                    <TextBlock Text="Archives to keep (0 = keep all)" FontSize="13" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="KeepCountBox" Width="200" HorizontalAlignment="Left"
                                AutomationProperties.Name="Archives to keep (0 = keep all)" />
                    <TextBlock Text="Delete archives older than this many days (0 = keep all)" FontSize="13" Margin="0,8,0,4" />
                    <ui:TextBox x:Name="MaxAgeBox" Width="200" HorizontalAlignment="Left"
                                AutomationProperties.Name="Delete archives older than this many days (0 = keep all)" />
                    <TextBlock MaxWidth="520" HorizontalAlignment="Left"
                               Text="0 means archives are never deleted. Retention runs on the server after every backup into this folder - scheduled or started by hand with Start backup now - and only once the new archive has been written and verified readable, so a failed backup never deletes anything. The newest archive is never deleted, the age limit always leaves the two newest alone, and only this server's own HMBackup archives are counted - other files in the folder are never touched."
                               FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,6,0,8" />
                    <TextBlock MaxWidth="520" HorizontalAlignment="Left"
                               Text="Keeping several generations of messages needs compression: without 'Compress destination files (zip)' every backup writes its message files into the same DataBackup folder, overwriting the previous run's, so retention can only keep generations of the small settings-and-domains archives."
                               FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock MaxWidth="520" HorizontalAlignment="Left"
                               Text="Stored in hMailServer.ini as ScheduledBackupTime, ScheduledBackupIntervalMinutes, ScheduledBackupKeepCount and ScheduledBackupMaxAgeDays. The service reads them when it starts, so changes here apply after a service restart."
                               FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="SaveScheduleButton" Content="Save schedule" Click="SaveSchedule_Click" Margin="0,0,8,0" />
                        <ui:Button Content="Re-check status" Click="RefreshScheduleStatus_Click"
                                   ToolTip="Re-read the schedule from hMailServer.ini and look at the destination folder again" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Restore" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Select the backup XML file created by a previous backup (in the destination folder). The contents replace the current data for the selected categories."
                               FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <TextBlock Text="Backup file (HMBackup*.xml on the server)" FontSize="13" Margin="0,0,0,4" />
                    <Grid Width="520" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="BackupFileBox" Grid.Column="0" />
                        <ui:Button x:Name="BrowseBackupFile" Grid.Column="1" Content="…" MinWidth="40" Margin="8,0,0,0"
                                   VerticalAlignment="Bottom" ToolTip="Browse for a file" Click="BrowseBackupFile_Click" />
                    </Grid>
                    <CheckBox x:Name="RestoreDomains" Content="Restore domains" FontSize="13.5" Margin="0,0,0,12" />
                    <CheckBox x:Name="RestoreMessages" Content="Restore messages" FontSize="13.5" Margin="0,0,0,12" />
                    <CheckBox x:Name="RestoreSettings" Content="Restore settings" FontSize="13.5" Margin="0,0,0,14" />
                    <ui:Button Content="Start restore" Appearance="Danger" Click="StartRestore_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
