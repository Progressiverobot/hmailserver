<UserControl
    x:Class="hMailServer.ControlPanel.Views.BackupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:hMailServer.ControlPanel.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource AppPagePadding}">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <scaffold:PageHeader x:Name="Header" Title="{loc:L 'Backup &amp; restore'}"
                                 Subtitle="{loc:L 'Back up domains, messages and settings to a folder; restore from a previous backup.'}" />

            <!-- What the last action said: settings saved, a backup started. -->
            <scaffold:InlineNotice x:Name="Notice" Visibility="Collapsed" />

            <scaffold:Card Title="{loc:L 'Backup'}" Margin="{StaticResource AppCardGap}">
                <StackPanel>
                    <scaffold:FieldRow Label="{loc:L 'Destination _folder (on the server)'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="DestinationBox" Grid.Column="0" />
                            <ui:Button x:Name="BrowseDestination" Grid.Column="1" Content="…" MinWidth="40" Margin="8,0,0,0"
                                       VerticalAlignment="Bottom" ToolTip="{loc:L 'Browse for a folder'}" Click="BrowseDestination_Click" />
                        </Grid>
                    </scaffold:FieldRow>
                    <CheckBox x:Name="CheckDomains" Content="{loc:L 'Back up _domains (accounts, aliases, lists)'}" Margin="0,0,0,12" />
                    <CheckBox x:Name="CheckMessages" Content="{loc:L 'Back up _messages'}" Margin="0,0,0,8" />
                    <!-- The two hMailServer.ini switches under it, each with its note
                         as the hint (which is also the editor's help text). -->
                    <scaffold:FieldRow x:Name="MessagesDbOnlyRow" Margin="22,0,0,12"
                                       Hint="{loc:L 'hMailServer.ini setting BackupMessagesDBOnly. The backup then records which messages exist but not their contents, and a restore expects the files to still be in the data folder. Applies to backup and restore, after a service restart.'}">
                        <CheckBox x:Name="CheckMessagesDbOnly" Content="{loc:L 'Message metadata _only — do not copy the message files'}" />
                    </scaffold:FieldRow>
                    <scaffold:FieldRow x:Name="VerifyRestoreRow" Margin="22,0,0,12"
                                       Hint="{loc:L 'hMailServer.ini setting BackupVerifyRestore, on by default. After the archive is written its message store is extracted to the temp folder through the same code a restore uses, held to exactly the files the backup staged, and every message row is checked for its file; the result is in the backup log. The store exists twice while it runs, so turn it off for a store the temp volume cannot hold. Applies after a service restart.'}">
                        <CheckBox x:Name="CheckVerifyRestore" Content="{loc:L '_Verify each backup by extracting its message store and reconciling it against the rows'}" />
                    </scaffold:FieldRow>
                    <CheckBox x:Name="CheckSettings" Content="{loc:L 'Back up _settings'}" Margin="0,0,0,12" />
                    <CheckBox x:Name="CheckCompress" Content="{loc:L '_Compress destination files (zip)'}" />
                </StackPanel>
                <scaffold:Card.Footer>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="{loc:L 'Save s_ettings'}" Click="SaveSettings_Click" Margin="0,0,8,0" />
                        <ui:Button Content="{loc:L 'Start _backup now'}" Appearance="Primary" Click="StartBackup_Click" />
                    </StackPanel>
                </scaffold:Card.Footer>
            </scaffold:Card>

            <scaffold:Card Title="{loc:L 'Scheduled backups'}" Margin="{StaticResource AppCardGap}">
                <StackPanel>
                    <!-- State first: whether a schedule exists and how old the newest archive is.
                         Colour, shape AND word (StatusSemantics), so no channel is load-bearing alone. -->
                    <scaffold:InlineNotice x:Name="ScheduleNotice" />
                    <scaffold:InlineNotice x:Name="LastBackupNotice" Margin="0,0,0,16" />

                    <scaffold:FieldRow Label="{loc:L 'Daily backup t_ime (24-hour HH:MM, empty = off)'}"
                                       Hint="{loc:L 'At most one backup per calendar day, taken at the first check at or after this time (the server\'s local time). If an interval is also set below, the daily time wins.'}">
                        <ui:TextBox x:Name="ScheduleTimeBox" MaxWidth="200" HorizontalAlignment="Left"
                                    AutomationProperties.Name="{loc:L 'Daily backup time (24-hour HH:MM, empty = off)'}" />
                    </scaffold:FieldRow>

                    <scaffold:FieldRow Label="{loc:L 'Backup interva_l in minutes (0 = off)'}"
                                       Hint="{loc:L 'Used when no daily time is set. The interval is measured against the newest archive in the destination, so it survives service restarts; if the destination holds no backup at all, the first one is taken about a minute after the service starts.'}">
                        <ui:TextBox x:Name="IntervalBox" MaxWidth="200" HorizontalAlignment="Left"
                                    AutomationProperties.Name="{loc:L 'Backup interval in minutes (0 = off)'}" />
                    </scaffold:FieldRow>

                    <scaffold:SettingsSection Heading="{loc:L 'Retention'}" Margin="0,4,0,0">
                        <StackPanel>
                            <scaffold:FieldRow Label="{loc:L 'Archives to kee_p (0 = keep all)'}">
                                <ui:TextBox x:Name="KeepCountBox" MaxWidth="200" HorizontalAlignment="Left"
                                            AutomationProperties.Name="{loc:L 'Archives to keep (0 = keep all)'}" />
                            </scaffold:FieldRow>
                            <scaffold:FieldRow Label="{loc:L 'Delete archives older tha_n this many days (0 = keep all)'}"
                                               Hint="{loc:L '0 means archives are never deleted. Retention runs on the server after every backup into this folder - scheduled or started by hand with Start backup now - and only once the new archive has been written and verified readable, so a failed backup never deletes anything. The newest archive is never deleted, the age limit always leaves the two newest alone, and only this server\'s own HMBackup archives are counted - other files in the folder are never touched.'}">
                                <ui:TextBox x:Name="MaxAgeBox" MaxWidth="200" HorizontalAlignment="Left"
                                            AutomationProperties.Name="{loc:L 'Delete archives older than this many days (0 = keep all)'}" />
                            </scaffold:FieldRow>
                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,8"
                                       Text="{loc:L 'Keeping several generations of messages needs compression: without \'Compress destination files (zip)\' every backup writes its message files into the same DataBackup folder, overwriting the previous run\'s, so retention can only keep generations of the small settings-and-domains archives.'}" />
                            <TextBlock Style="{StaticResource TextCaption}"
                                       Text="{loc:L 'Stored in hMailServer.ini as ScheduledBackupTime, ScheduledBackupIntervalMinutes, ScheduledBackupKeepCount and ScheduledBackupMaxAgeDays. The service reads them when it starts, so changes here apply after a service restart.'}" />
                        </StackPanel>
                    </scaffold:SettingsSection>
                </StackPanel>
                <scaffold:Card.Footer>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="SaveScheduleButton" Content="{loc:L 'Save sc_hedule'}" Click="SaveSchedule_Click" Margin="0,0,8,0" />
                        <ui:Button Content="{loc:L 'Re-chec_k status'}" Click="RefreshScheduleStatus_Click"
                                   ToolTip="{loc:L 'Re-read the schedule from hMailServer.ini and look at the destination folder again'}" />
                    </StackPanel>
                </scaffold:Card.Footer>
            </scaffold:Card>

            <scaffold:Card Title="{loc:L 'Restore'}"
                           Description="{loc:L 'Select the backup XML file created by a previous backup (in the destination folder). The contents replace the current data for the selected categories.'}">
                <StackPanel>
                    <scaffold:FieldRow Label="{loc:L 'Back_up file (HMBackup*.xml on the server)'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="BackupFileBox" Grid.Column="0" />
                            <ui:Button x:Name="BrowseBackupFile" Grid.Column="1" Content="…" MinWidth="40" Margin="8,0,0,0"
                                       VerticalAlignment="Bottom" ToolTip="{loc:L 'Browse for a file'}" Click="BrowseBackupFile_Click" />
                        </Grid>
                    </scaffold:FieldRow>
                    <CheckBox x:Name="RestoreDomains" Content="{loc:L 'Restore dom_ains'}" Margin="0,0,0,12" />
                    <CheckBox x:Name="RestoreMessages" Content="{loc:L 'Restore messa_ges'}" Margin="0,0,0,12" />
                    <CheckBox x:Name="RestoreSettings" Content="{loc:L 'Res_tore settings'}" />
                </StackPanel>
                <scaffold:Card.Footer>
                    <ui:Button Content="{loc:L 'Start _restore'}" Appearance="Danger" Click="StartRestore_Click" HorizontalAlignment="Left" />
                </scaffold:Card.Footer>
            </scaffold:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
