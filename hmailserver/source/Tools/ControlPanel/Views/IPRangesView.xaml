<UserControl
    x:Class="hMailServer.ControlPanel.Views.IPRangesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{loc:L 'IP ranges'}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{loc:L 'Access control: which addresses may connect and what they are allowed to do. Higher priority wins.'}"
                       Style="{StaticResource PageSubtitle}" />
            <ui:TextBox x:Name="SearchBox" PlaceholderText="{loc:L 'Search IP ranges...'}" Width="300"
                        HorizontalAlignment="Left" Margin="0,10,0,0" TextChanged="Search_TextChanged"
                        AutomationProperties.Name="{loc:L 'Search IP ranges'}">
                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
            </ui:TextBox>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
            <DataGrid x:Name="RangeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0" RowHeight="34"
                      SelectionMode="Single" SelectionChanged="RangeGrid_SelectionChanged"
                      MouseDoubleClick="Edit_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:L 'Name'}" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="{loc:L 'Lower IP'}" Binding="{Binding LowerIP}" Width="150" />
                    <DataGridTextColumn Header="{loc:L 'Upper IP'}" Binding="{Binding UpperIP}" Width="150" />
                    <DataGridTextColumn Header="{loc:L 'Priority'}" Binding="{Binding Priority}" Width="80" />
                    <DataGridTextColumn Header="SMTP" Binding="{Binding Smtp}" Width="70" />
                    <DataGridTextColumn Header="IMAP" Binding="{Binding Imap}" Width="70" />
                    <DataGridTextColumn Header="POP3" Binding="{Binding Pop3}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyStatus" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="PermHeader" Text="{loc:L 'Permissions (select a range)'}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <CheckBox x:Name="PermSmtp" Content="{loc:L 'Allow _SMTP'}" FontSize="14" Margin="0,0,12,8" />
                    <CheckBox x:Name="PermImap" Content="{loc:L 'Allow _IMAP'}" FontSize="14" Margin="0,0,12,8" />
                    <CheckBox x:Name="PermPop3" Content="{loc:L 'Allow _POP3'}" FontSize="14" Margin="0,0,12,8" />
                    <CheckBox x:Name="PermTlsAuth" Content="{loc:L 'Require _TLS for auth'}" FontSize="14" Margin="0,0,12,8" />
                    <CheckBox x:Name="PermLL" Content="{loc:L 'Deliver _local → local'}" FontSize="14" Margin="0,0,12,0" />
                    <CheckBox x:Name="PermLR" Content="{loc:L 'Deliver local → _remote'}" FontSize="14" Margin="0,0,12,0" />
                    <CheckBox x:Name="PermRL" Content="{loc:L '_Deliver remote → local'}" FontSize="14" Margin="0,0,12,0" />
                    <CheckBox x:Name="PermRR" Content="{loc:L 'Deliver remote → remote (rela_y)'}" FontSize="14" Margin="0,0,12,0" />
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="SavePermsButton" Content="{loc:L 'Sa_ve permissions'}" Appearance="Primary" Click="SavePerms_Click" IsEnabled="False" Margin="0,0,8,0" />
                    <ui:Button Content="{loc:L 'Pr_operties…'}" Click="Edit_Click" Margin="0,0,8,0" />
                    <ui:Button Content="{loc:L 'Delete selected ra_nge'}" Appearance="Secondary"
                               Foreground="{DynamicResource AppDangerBrush}" Click="Delete_Click" Margin="0,0,8,0" />
                    <ui:Button Content="{loc:L 'Restore de_faults'}" Click="RestoreDefaults_Click"
                               ToolTip="{loc:L 'Replaces every range with the standard two: \'My computer\' (127.0.0.1) and \'Internet\' (everything else).'}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{loc:L 'Add range'}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="NewName" PlaceholderText="{loc:L 'Name'}" Margin="0,0,8,0" />
                    <ui:TextBox x:Name="NewLower" Grid.Column="1" PlaceholderText="{loc:L 'Lower IP (e.g. 10.0.0.0)'}" Margin="0,0,8,0" />
                    <ui:TextBox x:Name="NewUpper" Grid.Column="2" PlaceholderText="{loc:L 'Upper IP (e.g. 10.0.0.255)'}" Margin="0,0,8,0" />
                    <ui:TextBox x:Name="NewPriority" Grid.Column="3" PlaceholderText="{loc:L 'Priority'}" Text="15" Margin="0,0,8,0" />
                    <ui:Button Grid.Column="4" Content="{loc:L '_Add'}" Appearance="Primary" Click="Add_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
