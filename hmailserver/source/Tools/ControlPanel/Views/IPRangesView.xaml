<UserControl
    x:Class="hMailServer.ControlPanel.Views.IPRangesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader Title="{loc:L 'IP ranges'}"
                             Subtitle="{loc:L 'Access control: which addresses may connect and what they are allowed to do. Higher priority wins.'}" />

        <scaffold:Toolbar x:Name="SearchBar" Grid.Row="1" SearchPlaceholder="{loc:L 'Search IP ranges'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{loc:L 'Pr_operties…'}" Click="Edit_Click" Margin="0,0,8,0" />
                    <ui:Button Content="{loc:L 'Delete selected ra_nge'}" Appearance="Secondary"
                               Foreground="{DynamicResource AppDangerBrush}" Click="Delete_Click" Margin="0,0,8,0" />
                    <ui:Button Content="{loc:L 'Restore de_faults'}" Click="RestoreDefaults_Click"
                               ToolTip="{loc:L 'Replaces every range with the standard two: \'My computer\' (127.0.0.1) and \'Internet\' (everything else).'}" />
                </StackPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <scaffold:Card Grid.Row="2" Padding="8">
            <Grid>
                <DataGrid x:Name="RangeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionChanged="RangeGrid_SelectionChanged"
                          MouseDoubleClick="Edit_Click"
                          AutomationProperties.Name="{loc:L 'IP ranges'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:L 'Name'}" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="{loc:L 'Lower IP'}" Binding="{Binding LowerIP}" Width="150" />
                        <DataGridTextColumn Header="{loc:L 'Upper IP'}" Binding="{Binding UpperIP}" Width="150" />
                        <DataGridTextColumn Header="{loc:L 'Priority'}" Binding="{Binding Priority}" Width="80"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn Header="SMTP" Binding="{Binding Smtp}" Width="70" />
                        <DataGridTextColumn Header="IMAP" Binding="{Binding Imap}" Width="70" />
                        <DataGridTextColumn Header="POP3" Binding="{Binding Pop3}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="ShieldLock24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </scaffold:Card>

        <!-- The selected range's permissions. The card's title names the range;
             Save is the card's own action, in its footer. -->
        <scaffold:Card x:Name="PermCard" Grid.Row="3" Title="{loc:L 'Permissions (select a range)'}" Margin="0,12,0,0">
            <UniformGrid Columns="4">
                <CheckBox x:Name="PermSmtp" Content="{loc:L 'Allow _SMTP'}" Margin="0,0,12,8" />
                <CheckBox x:Name="PermImap" Content="{loc:L 'Allow _IMAP'}" Margin="0,0,12,8" />
                <CheckBox x:Name="PermPop3" Content="{loc:L 'Allow _POP3'}" Margin="0,0,12,8" />
                <CheckBox x:Name="PermTlsAuth" Content="{loc:L 'Require _TLS for auth'}" Margin="0,0,12,8" />
                <CheckBox x:Name="PermLL" Content="{loc:L 'Deliver _local → local'}" Margin="0,0,12,0" />
                <CheckBox x:Name="PermLR" Content="{loc:L 'Deliver local → _remote'}" Margin="0,0,12,0" />
                <CheckBox x:Name="PermRL" Content="{loc:L '_Deliver remote → local'}" Margin="0,0,12,0" />
                <CheckBox x:Name="PermRR" Content="{loc:L 'Deliver remote → remote (rela_y)'}" Margin="0,0,12,0" />
            </UniformGrid>
            <scaffold:Card.Footer>
                <ui:Button x:Name="SavePermsButton" Content="{loc:L 'Sa_ve permissions'}" Appearance="Primary"
                           Click="SavePerms_Click" IsEnabled="False" HorizontalAlignment="Left" />
            </scaffold:Card.Footer>
        </scaffold:Card>

        <scaffold:Card Grid.Row="4" Title="{loc:L 'Add range'}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <scaffold:FieldRow Label="{loc:L 'Name'}" Margin="0,0,8,0">
                    <ui:TextBox x:Name="NewName" />
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="1" Label="{loc:L 'Lower IP (e.g. 10.0.0.0)'}" Margin="0,0,8,0">
                    <ui:TextBox x:Name="NewLower" />
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="2" Label="{loc:L 'Upper IP (e.g. 10.0.0.255)'}" Margin="0,0,8,0">
                    <ui:TextBox x:Name="NewUpper" />
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="3" Label="{loc:L 'Priority'}" Margin="0,0,8,0">
                    <ui:TextBox x:Name="NewPriority" Text="15" />
                </scaffold:FieldRow>
                <ui:Button Grid.Column="4" Content="{loc:L '_Add'}" Appearance="Primary" Click="Add_Click"
                           VerticalAlignment="Bottom" Margin="0,0,0,12" />
            </Grid>
        </scaffold:Card>
    </Grid>
</UserControl>
