<UserControl
    x:Class="hMailServer.ControlPanel.Views.DomainsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:hMailServer.ControlPanel.Views">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader Title="{loc:L 'Domains &amp; accounts'}"
                             Subtitle="{loc:L 'Manage the domains hosted by this server and their mailboxes.'}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- Domain list -->
            <scaffold:Card Margin="0,0,12,0" Padding="12" Grid.RowSpan="2" AutomationProperties.Name="{loc:L 'Domains'}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <scaffold:Toolbar x:Name="DomainSearch" SearchPlaceholder="{loc:L 'Search domains'}"
                                      SearchTextChanged="DomainSearch_TextChanged" Margin="0,0,0,8" />
                    <ListView x:Name="DomainList" Grid.Row="1" SelectionChanged="DomainList_SelectionChanged"
                              BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="{loc:L 'Domains'}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- An inactive domain is dimmed AND says so in words: opacity
                                         alone does not survive High Contrast, a projector, or a
                                         screen reader, and the word alone is easy to scan past. -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Active}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:SymbolIcon Symbol="Globe24" Foreground="{DynamicResource AppBrandBrush}" />
                                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:L 'inactive'}" FontSize="12" FontStyle="Italic" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Active}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="{loc:L 'Properties'}" FontSize="12" Padding="8,3" Margin="0,0,6,0"
                                               Tag="{Binding Name}" Click="EditDomain_Click" />
                                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}" Padding="6,3"
                                               ToolTip="{loc:L 'Delete domain'}" AutomationProperties.Name="{loc:L 'Delete domain'}"
                                               Foreground="{DynamicResource AppDangerBrush}"
                                               Tag="{Binding Name}" Click="DeleteDomain_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <scaffold:EmptyState x:Name="DomainStatus" Grid.Row="1" Icon="Globe24" Visibility="Collapsed"
                                         Padding="12" AutomationProperties.LiveSetting="Polite" />
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <scaffold:FieldRow Label="{loc:L 'Domain'}" Margin="0,0,8,0">
                            <ui:TextBox x:Name="NewDomainBox" PlaceholderText="newdomain.com" />
                        </scaffold:FieldRow>
                        <ui:Button Grid.Column="1" Content="{loc:L '_Add domain'}" Click="AddDomain_Click"
                                   VerticalAlignment="Bottom" Margin="0,0,0,12" />
                    </Grid>
                </Grid>
            </scaffold:Card>

            <!-- Accounts for the selected domain. The card's title names the
                 domain, set from code. -->
            <scaffold:Card x:Name="AccountsCard" Grid.Column="1" Title="{loc:L 'Select a domain'}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <scaffold:Toolbar x:Name="AccountSearch" SearchPlaceholder="{loc:L 'Search accounts'}"
                                      SearchTextChanged="AccountSearch_TextChanged" Margin="0,0,0,8" />

                    <ListView x:Name="AccountList" Grid.Row="1" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                              AutomationProperties.Name="{loc:L 'Accounts'}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Active}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:SymbolIcon Symbol="Person24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Address}" Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:L 'inactive'}" FontSize="12" FontStyle="Italic" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Active}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="{loc:L 'Edit'}" FontSize="12" Padding="8,3" Margin="0,0,6,0"
                                               Tag="{Binding Address}" Click="EditAccount_Click" />
                                    <ui:Button Grid.Column="2" Content="{loc:L 'Delete'}" Appearance="Secondary" FontSize="12"
                                               Foreground="{DynamicResource AppDangerBrush}"
                                               Padding="8,3" Tag="{Binding Address}" Click="DeleteAccount_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <scaffold:EmptyState x:Name="AccountStatus" Grid.Row="1" Icon="Person24" Visibility="Collapsed"
                                         Padding="12" AutomationProperties.LiveSetting="Polite" />

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <scaffold:FieldRow Label="{loc:L 'Address'}" Margin="0,0,8,0">
                            <ui:TextBox x:Name="NewAccountBox" PlaceholderText="user@domain" />
                        </scaffold:FieldRow>
                        <scaffold:FieldRow Grid.Column="1" Label="{loc:L 'Password'}" Margin="0,0,8,0">
                            <local:PasswordField x:Name="NewAccountPassword" />
                        </scaffold:FieldRow>
                        <ui:Button Grid.Column="2" Content="{loc:L '_Generate'}" Margin="0,0,8,12" VerticalAlignment="Bottom"
                                   Click="GenerateAccountPassword_Click"
                                   ToolTip="{loc:L 'Generate a strong password (copied to clipboard)'}" />
                        <ui:Button Grid.Column="3" Content="{loc:L '_Create account'}" Appearance="Primary" Click="AddAccount_Click"
                                   VerticalAlignment="Bottom" Margin="0,0,0,12" />
                    </Grid>
                </Grid>
            </scaffold:Card>

            <!-- Aliases + distribution lists -->
            <Grid Grid.Column="1" Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <scaffold:Card Title="{loc:L 'Aliases'}" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="AliasList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="{loc:L 'Aliases'}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Display}" FontSize="12" VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Delete24}" Padding="6,2"
                                                   ToolTip="{loc:L 'Delete alias'}" AutomationProperties.Name="{loc:L 'Delete alias'}"
                                                   Tag="{Binding Name}" Click="DeleteAlias_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <scaffold:EmptyState x:Name="AliasStatus" Visibility="Collapsed" Padding="12"
                                             AutomationProperties.LiveSetting="Polite" />
                        <!-- The example placeholders are the whole caption of these
                             two boxes: alias@domain forwards to target@anywhere. -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="NewAliasName" PlaceholderText="alias@domain" FontSize="12" Margin="0,0,6,0" />
                            <ui:TextBox x:Name="NewAliasValue" Grid.Column="1" PlaceholderText="target@anywhere" FontSize="12" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="2" Content="{loc:L 'Add a_lias'}" FontSize="12" Click="AddAlias_Click"
                                       AutomationProperties.Name="{loc:L 'Add alias'}" />
                        </Grid>
                    </Grid>
                </scaffold:Card>

                <scaffold:Card Grid.Column="1" Title="{loc:L 'Distribution lists'}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="DistList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="{loc:L 'Distribution lists'}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="1" Content="{loc:L 'Properties'}" FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                                   Tag="{Binding}" Click="EditDistList_Click" />
                                        <ui:Button Grid.Column="2" Content="{loc:L 'Members'}" FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                                   Tag="{Binding}" Click="EditRecipients_Click" />
                                        <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Delete24}" Padding="6,2"
                                                   ToolTip="{loc:L 'Delete distribution list'}" AutomationProperties.Name="{loc:L 'Delete distribution list'}"
                                                   Tag="{Binding}" Click="DeleteDistList_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <scaffold:EmptyState x:Name="DistStatus" Visibility="Collapsed" Padding="12"
                                             AutomationProperties.LiveSetting="Polite" />
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="NewDistAddress" PlaceholderText="list@domain" FontSize="12" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="1" Content="{loc:L 'Add li_st'}" FontSize="12" Click="AddDistList_Click"
                                       AutomationProperties.Name="{loc:L 'Add distribution list'}" />
                        </Grid>
                    </Grid>
                </scaffold:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
