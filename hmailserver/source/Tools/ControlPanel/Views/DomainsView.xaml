<UserControl
    x:Class="hMailServer.ControlPanel.Views.DomainsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Domains &amp; accounts" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Manage the domains hosted by this server and their mailboxes."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- Domain list -->
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10" Grid.RowSpan="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBox x:Name="DomainSearch" Grid.Row="0" PlaceholderText="Search domains..."
                                Margin="4,0,4,8" TextChanged="DomainSearch_TextChanged"
                                AutomationProperties.Name="Search domains">
                        <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
                    </ui:TextBox>
                    <ListView x:Name="DomainList" Grid.Row="1" SelectionChanged="DomainList_SelectionChanged"
                              BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- An inactive domain is dimmed AND says so in words: opacity
                                         alone does not survive High Contrast, a projector, or a
                                         screen reader, and the word alone is easy to scan past. -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Active}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:SymbolIcon Symbol="Globe24" Foreground="{StaticResource BrandBrush}" />
                                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="inactive" FontSize="12" FontStyle="Italic" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Active}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="Properties" FontSize="12" Padding="8,3" Margin="0,0,6,0"
                                               Tag="{Binding Name}" Click="EditDomain_Click" />
                                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}" Padding="6,3"
                                               ToolTip="Delete domain" AutomationProperties.Name="Delete domain"
                                               Foreground="{DynamicResource AppDangerBrush}"
                                               Tag="{Binding Name}" Click="DeleteDomain_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,10,0,2">
                        <ui:TextBox x:Name="NewDomainBox" PlaceholderText="newdomain.com" Width="180" />
                        <ui:Button Content="Add domain" Margin="8,0,0,0" Click="AddDomain_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Accounts for the selected domain -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="AccountsHeader" Text="Select a domain" FontWeight="SemiBold"
                               FontSize="14" Margin="6,4,0,8"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <ui:TextBox x:Name="AccountSearch" Grid.Row="1" PlaceholderText="Search accounts..."
                                Margin="6,0,0,8" TextChanged="AccountSearch_TextChanged"
                                AutomationProperties.Name="Search accounts">
                        <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
                    </ui:TextBox>

                    <ListView x:Name="AccountList" Grid.Row="2" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Active}" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ui:SymbolIcon Symbol="Person24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Address}" Margin="10,0,0,0" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="inactive" FontSize="12" FontStyle="Italic" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Active}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="Edit" FontSize="12" Padding="8,3" Margin="0,0,6,0"
                                               Tag="{Binding Address}" Click="EditAccount_Click" />
                                    <ui:Button Grid.Column="2" Content="Delete" Appearance="Secondary" FontSize="12"
                                               Foreground="{DynamicResource AppDangerBrush}"
                                               Padding="8,3" Tag="{Binding Address}" Click="DeleteAccount_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="3" Margin="4,10,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="NewAccountBox" PlaceholderText="user@domain" Margin="0,0,8,0" />
                        <ui:PasswordBox x:Name="NewAccountPassword" Grid.Column="1" PlaceholderText="Password" Margin="0,0,8,0" />
                        <ui:Button Grid.Column="2" Content="Generate" Margin="0,0,8,0" Click="GenerateAccountPassword_Click"
                                   ToolTip="Generate a strong password (copied to clipboard)" />
                        <ui:Button Grid.Column="3" Content="Create account" Appearance="Primary" Click="AddAccount_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Aliases + distribution lists -->
            <Grid Grid.Column="1" Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Aliases" FontWeight="SemiBold" FontSize="14" Margin="6,2,0,6" />
                        <ListView x:Name="AliasList" Grid.Row="1" BorderThickness="0" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Display}" FontSize="12" VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Delete24}" Padding="6,2"
                                                   ToolTip="Delete alias" AutomationProperties.Name="Delete alias"
                                                   Tag="{Binding Name}" Click="DeleteAlias_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="AliasStatus" Grid.Row="1" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Opacity="0.7"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12" />
                        <Grid Grid.Row="2" Margin="4,8,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="NewAliasName" PlaceholderText="alias@domain" FontSize="12" Margin="0,0,6,0" />
                            <ui:TextBox x:Name="NewAliasValue" Grid.Column="1" PlaceholderText="target@anywhere" FontSize="12" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="2" Content="Add" FontSize="12" Click="AddAlias_Click"
                                       AutomationProperties.Name="Add alias" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Distribution lists" FontWeight="SemiBold" FontSize="14" Margin="6,2,0,6" />
                        <ListView x:Name="DistList" Grid.Row="1" BorderThickness="0" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="1" Content="Properties" FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                                   Tag="{Binding}" Click="EditDistList_Click" />
                                        <ui:Button Grid.Column="2" Content="Members" FontSize="10" Padding="6,2" Margin="0,0,4,0"
                                                   Tag="{Binding}" Click="EditRecipients_Click" />
                                        <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Delete24}" Padding="6,2"
                                                   ToolTip="Delete distribution list" AutomationProperties.Name="Delete distribution list"
                                                   Tag="{Binding}" Click="DeleteDistList_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="DistStatus" Grid.Row="1" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Opacity="0.7"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12" />
                        <Grid Grid.Row="2" Margin="4,8,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="NewDistAddress" PlaceholderText="list@domain" FontSize="12" Margin="0,0,6,0" />
                            <ui:Button Grid.Column="1" Content="Add" FontSize="12" Click="AddDistList_Click"
                                       AutomationProperties.Name="Add distribution list" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
