<UserControl
    x:Class="hMailServer.ControlPanel.Views.ConnectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:local="clr-namespace:hMailServer.ControlPanel.Views"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- The first screen anybody sees, on the scaffold: a Card, three FieldRows
         and an InlineNotice for the failure. The rows give the three editors the
         accessible names and Alt keys the placeholders never did. -->
    <Grid>
        <scaffold:Card MaxWidth="420" MinWidth="320" Padding="32,28" Margin="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       AutomationProperties.Name="{loc:L 'Connect to server'}">
            <StackPanel>
                <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource BrandGradient}"
                        HorizontalAlignment="Left" Margin="0,0,0,16">
                    <TextBlock Text="hM" FontWeight="SemiBold" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="{loc:L 'Connect to server'}" Style="{StaticResource TextSubtitle}" />
                <TextBlock Text="{loc:L 'Sign in with the hMailServer administrator credential.'}"
                           Style="{StaticResource TextCaption}" Margin="0,4,0,20" />

                <scaffold:FieldRow Label="{loc:L '_Server'}">
                    <ui:TextBox x:Name="HostBox" PlaceholderText="{loc:L 'Server (localhost)'}" Text="localhost">
                        <ui:TextBox.Icon><ui:SymbolIcon Symbol="Server24" /></ui:TextBox.Icon>
                    </ui:TextBox>
                </scaffold:FieldRow>
                <!-- The user name is NOT translated. It is the account the server
                     authenticates, and hMailServer's is called Administrator in
                     every language; a translated word here is a name no account
                     has, and the sign-in fails with "check the user name and
                     password" (issue #156). The caption above it is translated. -->
                <scaffold:FieldRow Label="{loc:L '_User name'}">
                    <ui:TextBox x:Name="UserBox" Text="Administrator"> <!-- no-loc -->
                        <ui:TextBox.Icon><ui:SymbolIcon Symbol="Person24" /></ui:TextBox.Icon>
                    </ui:TextBox>
                </scaffold:FieldRow>
                <scaffold:FieldRow Label="{loc:L '_Password'}" Margin="0,0,0,18">
                    <local:PasswordField x:Name="PasswordBox">
                        <local:PasswordField.Icon><ui:SymbolIcon Symbol="Key24" /></local:PasswordField.Icon>
                    </local:PasswordField>
                </scaffold:FieldRow>

                <!-- The button and the busy indicator occupy the same cell, so the
                     card does not change height when a connection starts. A layout
                     that jumps as soon as you click it reads as instability, which
                     is the opposite of what a progress indicator is for. -->
                <Grid Height="38">
                    <ui:Button x:Name="ConnectButton" Content="{loc:L '_Connect'}" Appearance="Primary"
                               HorizontalAlignment="Stretch" Height="38" Click="Connect_Click" />
                    <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" />
                        <TextBlock x:Name="BusyText" Text="{loc:L 'Connecting…'}" FontSize="13" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Assertive: a failed sign-in is the one thing on this screen a
                     screen reader must hear at once. -->
                <scaffold:InlineNotice x:Name="ErrorNotice" Level="Critical" Visibility="Collapsed" Margin="0,12,0,0"
                                       AutomationProperties.LiveSetting="Assertive" />

                <ui:HyperlinkButton Content="{loc:L 'Set up two-factor authentication…'}" Click="Totp_Click"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" FontSize="12" />

                <!-- The language, before sign-in, because the person who needs it
                     is the one who cannot read the rest of this card. A change
                     restarts the Control Panel (LanguageChoice says why). -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L '_Language'}" local:Mnemonic.Target="{Binding ElementName=LanguageBox}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" FontSize="12" HorizontalAlignment="Left" MinWidth="180"
                              AutomationProperties.Name="{loc:L 'Language'}"
                              SelectionChanged="Language_SelectionChanged" DropDownClosed="Language_DropDownClosed" />
                </Grid>
            </StackPanel>
        </scaffold:Card>
    </Grid>
</UserControl>
