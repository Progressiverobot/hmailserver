<UserControl
    x:Class="hMailServer.ControlPanel.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Text="Live server statistics, refreshed every 2 seconds."
                       Style="{StaticResource PageSubtitle}" />

            <!-- "Needs attention" summary. The dashboard is the page an
                 administrator lands on, so the one question the External setup
                 page can answer - "is this server actually set up, and if not
                 what next?" - is answered here too, or it is only answered for
                 people who already knew where to look. The checks themselves are
                 ExternalSetupChecks, the same code that page runs, so the two can
                 never disagree. State is shown as colour + shape + word (the
                 application-wide status vocabulary), never colour alone, and each
                 item that needs action is one click from the page that fixes it.
                 The check starts after first paint and its DNS half runs off the
                 UI thread, so this card never delays the dashboard. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="AttentionMark" Width="11" Height="11" Stretch="Fill"
                              Margin="0,4,8,0" VerticalAlignment="Top" Visibility="Collapsed" />
                        <TextBlock x:Name="AttentionStateWord" Grid.Column="1" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Top"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="AttentionSummary" Grid.Column="2" FontSize="14"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="Checking what this server still needs done outside it…" />
                        <ui:Button x:Name="OpenExternalSetupButton" Grid.Column="3" Content="External setup…"
                                   Appearance="Transparent" FontSize="12" Padding="8,3,8,3"
                                   VerticalAlignment="Top" Cursor="Hand" Click="OpenExternalSetup_Click"
                                   ToolTip="Open External setup, the full checklist of what this server needs done outside it"
                                   AutomationProperties.Name="Open External setup, the full checklist of what this server needs done outside it"
                                   AutomationProperties.AutomationId="dashboard-open-external-setup" />
                    </Grid>
                    <StackPanel x:Name="AttentionItems" Margin="19,2,0,0" />
                    <TextBlock x:Name="AttentionNote" FontSize="12" TextWrapping="Wrap" Margin="19,6,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- KPI row: fixed-height cards, value top-aligned, label bottom-anchored.
                 The accessible name of each value is set in code to "label, value"
                 on every refresh. AutomationProperties.LabeledBy looks like the
                 right tool and is not: on a TextBlock it *replaces* the announced
                 name, so a screen reader would read "IN QUEUE" and never say the
                 number. -->
            <UniformGrid Columns="5" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" MinHeight="96" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KpiUptime" Text="—" Style="{StaticResource KpiValue}" FontSize="20" />
                        <TextBlock Grid.Row="1" Text="Uptime" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" MinHeight="96" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KpiProcessed" Text="0" Style="{StaticResource KpiValue}" />
                        <TextBlock Grid.Row="1" Text="Messages processed" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" MinHeight="96" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- The queue is the one KPI that changes colour to say
                             something. The colour is never the only carrier of it:
                             the badge underneath adds a shape and the word
                             "Backlog", and the value's accessible name says it in
                             words as well. -->
                        <StackPanel>
                            <TextBlock x:Name="KpiQueue" Text="0" Style="{StaticResource KpiValue}" />
                            <!-- Hidden, not Collapsed, and for the reason ShowQueue_
                                 documents: a collapsed badge gives its space back,
                                 so the KPI row grows taller the first time the queue
                                 crosses the backlog threshold. ShowQueue_ sets
                                 Hidden; the initial value here said Collapsed, so
                                 the row still jumped once - on the first refresh
                                 after the page opened, which is exactly when an
                                 operator is looking at it. -->
                            <StackPanel x:Name="KpiQueueBadge" Orientation="Horizontal" Visibility="Hidden"
                                        Margin="0,4,0,0">
                                <Path x:Name="KpiQueueShape" Width="10" Height="10" Stretch="Fill"
                                      VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="KpiQueueBadgeText" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="IN QUEUE" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" MinHeight="96" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KpiSpam" Text="0" Style="{StaticResource KpiValue}" />
                        <TextBlock Grid.Row="1" Text="Spam blocked" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" MinHeight="96">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KpiViruses" Text="0" Style="{StaticResource KpiValue}" />
                        <TextBlock Grid.Row="1" Text="Viruses removed" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Charts. Both cards are built in code from ChartCatalog: an
                 AccessibleChartCard cannot exist without a chart definition, and it
                 builds its table view, legend, accessible description and clipboard
                 export from that same definition, which is what keeps "every chart
                 has a table view" true by construction rather than by review. -->
            <Grid x:Name="ChartsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
