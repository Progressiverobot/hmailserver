<UserControl
    x:Class="hMailServer.ControlPanel.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Text="Live server statistics, refreshed every 2 seconds."
                       Style="{StaticResource PageSubtitle}" />

            <!-- KPI row: fixed-height cards, value top-aligned, label bottom-anchored.
                 The accessible name of each value is set in code to "label, value"
                 on every refresh. AutomationProperties.LabeledBy looks like the
                 right tool and is not: on a TextBlock it *replaces* the announced
                 name, so a screen reader would read "IN QUEUE" and never say the
                 number. -->
            <UniformGrid Columns="5" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" MinHeight="96" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KpiUptime" Text="—" Style="{StaticResource KpiValue}" FontSize="22" />
                        <TextBlock Grid.Row="1" Text="UPTIME" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" MinHeight="96" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KpiProcessed" Text="0" Style="{StaticResource KpiValue}" />
                        <TextBlock Grid.Row="1" Text="MESSAGES PROCESSED" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" MinHeight="96" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- The queue is the one KPI that changes colour to say
                             something. The colour is never the only carrier of it:
                             the badge underneath adds a shape and the word
                             "Backlog", and the value's accessible name says it in
                             words as well. -->
                        <StackPanel>
                            <TextBlock x:Name="KpiQueue" Text="0" Style="{StaticResource KpiValue}" />
                            <!-- Hidden, not Collapsed, and for the reason ShowQueue_
                                 documents: a collapsed badge gives its space back,
                                 so the KPI row grows taller the first time the queue
                                 crosses the backlog threshold. ShowQueue_ sets
                                 Hidden; the initial value here said Collapsed, so
                                 the row still jumped once - on the first refresh
                                 after the page opened, which is exactly when an
                                 operator is looking at it. -->
                            <StackPanel x:Name="KpiQueueBadge" Orientation="Horizontal" Visibility="Hidden"
                                        Margin="0,4,0,0">
                                <Path x:Name="KpiQueueShape" Width="10" Height="10" Stretch="Fill"
                                      VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="KpiQueueBadgeText" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="IN QUEUE" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" MinHeight="96" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KpiSpam" Text="0" Style="{StaticResource KpiValue}" />
                        <TextBlock Grid.Row="1" Text="SPAM BLOCKED" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" MinHeight="96">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="KpiViruses" Text="0" Style="{StaticResource KpiValue}" />
                        <TextBlock Grid.Row="1" Text="VIRUSES REMOVED" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Charts. Both cards are built in code from ChartCatalog: an
                 AccessibleChartCard cannot exist without a chart definition, and it
                 builds its table view, legend, accessible description and clipboard
                 export from that same definition, which is what keeps "every chart
                 has a table view" true by construction rather than by review. -->
            <Grid x:Name="ChartsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
