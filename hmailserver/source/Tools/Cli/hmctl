def rule_match_command(client, arguments):
    body = {"match_value": arguments.value, "match_type": arguments.type, "test_value": arguments.against}
    answer = client.request("POST", "/api/v1/rules/match", body=body)
    if arguments.json:
        render(answer, True)
    else:
        matched = answer.get("match") if isinstance(answer, dict) else answer
