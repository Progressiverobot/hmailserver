def build_parser():
    parser = argparse.ArgumentParser(
        prog="hmctl",
        description="Administer an hMailServer over its REST API.",
        epilog="Environment: HMAIL_URL, HMAIL_API_KEY, HMAIL_PASSWORD, HMAIL_PASSWORD_FILE.",
    )
    parser.add_argument("--url", default=os.environ.get("HMAIL_URL", DEFAULT_URL),
                        help="the server's REST address (default %s)" % DEFAULT_URL)
    parser.add_argument("--api-key", default=os.environ.get("HMAIL_API_KEY"))
    parser.add_argument("--password", default=os.environ.get("HMAIL_PASSWORD"))
    parser.add_argument("--password-file", default=os.environ.get("HMAIL_PASSWORD_FILE"))
    parser.add_argument("--insecure", action="store_true",
                        help="accept a self-signed certificate; loopback only")
    parser.add_argument("--json", action="store_true", help="the server's JSON, unformatted by this tool")
    parser.add_argument("--timeout", type=int, default=30)
    parser.add_argument("--version", action="version", version="hmctl " + VERSION)

    # The same flags again, for every parser below, because `hmctl domain list
    # --json` is where a person types it and argparse takes the main parser's
    # options only before the subcommand. SUPPRESS is what makes that safe: an
    # inherited flag that was not given leaves no attribute, so it cannot
    # overwrite the value the main parser already read from the command line or
    # from the environment with its own default.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--url", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--api-key", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--password", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--password-file", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--insecure", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="the server's JSON, unformatted by this tool")
    common.add_argument("--timeout", type=int, default=argparse.SUPPRESS, help=argparse.SUPPRESS)

    commands = parser.add_subparsers(dest="command")

    status = commands.add_parser("status", parents=[common], help="what the server says about itself")
    status.set_defaults(handler=status_command)

    for name in sorted(RESOURCES):
        resource = RESOURCES[name]
        sub = commands.add_parser(name, help=resource["help"])
        sub.set_defaults(handler=resource_command, resource=name)
        verbs = sub.add_subparsers(dest="verb")
        for verb in resource["verbs"]:
            verb_parser = verbs.add_parser(verb, parents=[common])
            if verb in ("get", "update", "delete"):
                verb_parser.add_argument("id", help="the %s" % resource["id"])
            if verb in ("create", "update"):
                verb_parser.add_argument("--set", action="append", metavar="NAME=VALUE",
                                         help="a field; true, false, null, numbers and JSON are read as such")
                verb_parser.add_argument("--set-string", action="append", metavar="NAME=VALUE",
                                         help="a field whose value stays a string")
                verb_parser.add_argument("--from-json", metavar="FILE", help="a JSON object, or - for stdin")
            if resource.get("parent"):
                verb_parser.add_argument("--" + resource["parent"],
                                         help="the %s these belong to" % resource["parent"])

    queue = commands.add_parser("queue", help="the delivery queue")
    queue.set_defaults(handler=queue_command)
    queue_verbs = queue.add_subparsers(dest="verb")
    queue_verbs.add_parser("list", parents=[common])
    for verb in ("retry", "delete"):
        p = queue_verbs.add_parser(verb, parents=[common])
        p.add_argument("id")

    quarantine = commands.add_parser("quarantine", help="held mail")
    quarantine.set_defaults(handler=quarantine_command)
    quarantine_verbs = quarantine.add_subparsers(dest="verb")
    quarantine_verbs.add_parser("list", parents=[common])
    for verb in ("release", "delete"):
        p = quarantine_verbs.add_parser(verb, parents=[common])
        p.add_argument("id")

    settings = commands.add_parser("settings", help="the server settings, by group")
    settings.set_defaults(handler=settings_command)
    settings_verbs = settings.add_subparsers(dest="verb")
    get = settings_verbs.add_parser("get", parents=[common])
    get.add_argument("group", nargs="?", choices=SETTING_GROUPS, default="settings")
    get.add_argument("name", nargs="?", help="one setting rather than the group")
    set_parser = settings_verbs.add_parser("set", parents=[common])
    set_parser.add_argument("group", nargs="?", choices=SETTING_GROUPS, default="settings")
    set_parser.add_argument("--set", action="append", metavar="NAME=VALUE", required=False)
    set_parser.add_argument("--set-string", action="append", metavar="NAME=VALUE")
    set_parser.add_argument("--from-json", metavar="FILE")
    set_parser.set_defaults(name=None)

    ini = commands.add_parser("ini", help="hMailServer.ini keys the server exposes")
    ini.set_defaults(handler=ini_command)
    ini_verbs = ini.add_subparsers(dest="verb")
    ini_verbs.add_parser("list", parents=[common])
    for verb in ("get", "delete"):
        p = ini_verbs.add_parser(verb, parents=[common])
        p.add_argument("name")
    p = ini_verbs.add_parser("set", parents=[common])
    p.add_argument("name")
    p.add_argument("value")

    log = commands.add_parser("log", help="the log files")
    log.set_defaults(handler=log_command)
    log_verbs = log.add_subparsers(dest="verb")
    log_verbs.add_parser("list", parents=[common])
    tail = log_verbs.add_parser("tail", parents=[common])
    tail.add_argument("name")
    tail.add_argument("--lines", type=int, default=50)

    backup = commands.add_parser("backup", help="the server's own backup")
    backup.set_defaults(handler=backup_command)
    backup_verbs = backup.add_subparsers(dest="verb")
    backup_verbs.add_parser("status", parents=[common])
    backup_verbs.add_parser("start", parents=[common])

    match = commands.add_parser("match", parents=[common], help="try a rule criterion against a value")
    match.set_defaults(handler=rule_match_command)
    match.add_argument("type", choices=["equals", "contains", "less_than", "greater_than",
                                        "regex", "not_contains", "not_equals", "wildcard"])
    match.add_argument("value", help="the criterion's value, as a rule stores it")
    match.add_argument("against", help="the text to try it against")

    app = commands.add_parser("app-password", help="an account's application passwords")
    app.set_defaults(handler=apppassword_command)
    app.add_argument("address")
    app_verbs = app.add_subparsers(dest="verb")
    app_verbs.add_parser("list", parents=[common])
    create = app_verbs.add_parser("create", parents=[common])
    create.add_argument("name")
    delete = app_verbs.add_parser("delete", parents=[common])
    delete.add_argument("id")

    member = commands.add_parser("member", help="the accounts in a group")
    member.set_defaults(handler=member_command)
    member.add_argument("group", help="the group's id")
    member_verbs = member.add_subparsers(dest="verb")
    member_verbs.add_parser("list", parents=[common])
    for verb in ("add", "remove"):
        p = member_verbs.add_parser(verb, parents=[common])
        p.add_argument("account", help="an address, or an account id")

    accounts = commands.add_parser("accounts", help="accounts in bulk, from and to a CSV file")
    accounts_verbs = accounts.add_subparsers(dest="verb")
    importer = accounts_verbs.add_parser("import", parents=[common])
    importer.set_defaults(handler=accounts_import)
    importer.add_argument("file")
    importer.add_argument("--domain", action="append",
                          help="the domain(s) to read existing addresses from; derived from the file when omitted")
    importer.add_argument("--dry-run", action="store_true", help="say what would happen and change nothing")
    exporter = accounts_verbs.add_parser("export", parents=[common])
    exporter.set_defaults(handler=accounts_export)
    exporter.add_argument("domain")
    exporter.add_argument("file", nargs="?", default="-")

    api = commands.add_parser("api", parents=[common], help="any method on any path - the escape hatch")
    api.set_defaults(handler=api_command)
    api.add_argument("method")
    api.add_argument("path")
    api.add_argument("body", nargs="?", help="a JSON body, or - for stdin")

    return parser


def can_prompt():
    """Whether there is a person at a console to answer a password prompt.

    Not sys.stdin.isatty() alone, which is wrong on Windows in the one case
    that matters: the NUL device is a character device, so isatty() answers
    True for it, and a scheduled task or a pipeline that redirected stdin from
    nul would sit at a prompt nobody can see until something killed it. That is
    the worst failure a small tool can have - silence - and it is exactly what
    a check of this file caught.

    GetConsoleMode tells the two apart: it succeeds only for a real console
    handle. Anywhere else isatty() is the right question.
    """
    if os.name != "nt":
        return sys.stdin.isatty()

    try:
        import ctypes
        import msvcrt

        handle = msvcrt.get_osfhandle(sys.stdin.fileno())
        mode = ctypes.c_uint()
        return bool(ctypes.windll.kernel32.GetConsoleMode(ctypes.c_void_p(handle), ctypes.byref(mode)))
    except Exception:
        return False


def resolve_password(arguments):
    if arguments.api_key:
        return None
    if arguments.password:
        return arguments.password
    if arguments.password_file:
        with io.open(arguments.password_file, encoding="utf-8") as handle:
            return handle.read().strip()
    if not can_prompt():
        raise ApiError(0, "no credential: give --api-key, --password, --password-file, or one of "
                          "HMAIL_API_KEY, HMAIL_PASSWORD, HMAIL_PASSWORD_FILE")
    return getpass.getpass("Administrator password for %s: " % arguments.url)


def main(argv=None):
    parser = build_parser()
    arguments = parser.parse_args(argv)

    if not getattr(arguments, "command", None):
        parser.print_help()
        return EXIT_USAGE
    if not getattr(arguments, "handler", None) or (
            "verb" in vars(arguments) and arguments.verb is None):
        parser.parse_args([arguments.command, "--help"])
        return EXIT_USAGE

    # SUPPRESS leaves an inherited flag out of the namespace when it was not
    # given after the subcommand, so every one of them is read with the main
    # parser's value behind it.
    for name, fallback in (("url", DEFAULT_URL), ("api_key", None), ("password", None),
                           ("password_file", None), ("insecure", False), ("json", False), ("timeout", 30)):
        if not hasattr(arguments, name):
            setattr(arguments, name, fallback)

    try:
        password = resolve_password(arguments)
        client = Client(arguments.url, api_key=arguments.api_key, password=password,
                        insecure=arguments.insecure, timeout=arguments.timeout)
        return arguments.handler(client, arguments)
    except ApiError as error:
        if error.status == 401:
            print("hmctl: the server refused the credential (401). Check the administrator password or the API key.",
                  file=sys.stderr)
            return EXIT_AUTH
        if error.status == 403:
            print("hmctl: forbidden (403): %s" % error.message, file=sys.stderr)
            return EXIT_AUTH
        if error.status == 404:
            print("hmctl: not found (404): %s" % error.message, file=sys.stderr)
            return EXIT_NOTFOUND
        print("hmctl: %s" % error.message, file=sys.stderr)
        return EXIT_ERROR
    except KeyboardInterrupt:
        return EXIT_ERROR
    except (OSError, IOError, ValueError) as error:
        print("hmctl: %s" % error, file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
