def apppassword_command(client, arguments):
    base = "/api/v1/accounts/%s/app-passwords" % urllib.parse.quote(arguments.address, safe="@")
    if arguments.verb == "list":
        render(collection(client.request("GET", base), "app_passwords"), arguments.json,
