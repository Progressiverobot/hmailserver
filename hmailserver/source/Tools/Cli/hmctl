        answer = client.request("POST", base, body={"name": arguments.name})
        render(answer, arguments.json)
        if not arguments.json and isinstance(answer, dict) and answer.get("password"):
            print("")
            print("This is the only time the server will show it.")
    elif arguments.verb == "delete":
        client.request("DELETE", "%s/%s" % (base, arguments.id))
        print("revoked.")
