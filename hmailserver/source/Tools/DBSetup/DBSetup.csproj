<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Framework-dependent win-x64; the installer bundles the .NET 8 Desktop
         Runtime. Same conventions as ControlPanel. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DBSetup</RootNamespace>
    <AssemblyName>DBSetup</AssemblyName>
    <ApplicationIcon>database_add.ico</ApplicationIcon>
    <Version>6.2.15</Version>
    <Product>hMailServer Database Setup</Product>
    <Company>Progressive Robot Ltd</Company>
    <Copyright>Copyright (c) 2026 Christopher Holloway / Progressive Robot Ltd</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
    <Reference Include="Interop.hMailServer">
      <HintPath>..\Interop\Interop.hMailServer.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
