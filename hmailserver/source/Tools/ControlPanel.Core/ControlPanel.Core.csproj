<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hMailCP.Core</AssemblyName>
    <RootNamespace>hMailServer.ControlPanel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\PasswordStrength.cs" />
    <Compile Include="..\ControlPanel\Services\NumericField.cs" />
    <Compile Include="..\ControlPanel\Services\PasswordGenerator.cs" />
    <!-- Parser for the server's message-store consistency report. No WPF, so the
         tests can pin the format the server actually writes. -->
    <Compile Include="..\ControlPanel\Services\MessageStoreConsistencyReport.cs" />
    <!-- Settings search index: plain data plus a search function, no WPF, so the
         tests can verify it still matches the settings pages. -->
    <Compile Include="..\ControlPanel\Services\SettingsSearchIndex.cs" />
    <Compile Include="..\ControlPanel\Services\SettingsSearchIndex.g.cs" />
  </ItemGroup>

</Project>
