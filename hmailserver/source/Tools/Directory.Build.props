<Project>
  <!--
    Applies to every C# project under source/Tools (the Control Panel, its
    tests, and the setup and migration tools). One property, for one reason:

    EnableWindowsTargeting lets `dotnet restore` succeed on a non-Windows
    machine for a project that targets net10.0-windows. Nothing here can RUN
    off Windows - the tools are WPF and WinForms - but GitHub's automatic
    dependency submission restores every project on a Linux runner to record
    the NuGet graph, and without this property that restore fails with
    NETSDK1100 on the first Windows-targeting project it meets, so the
    submission was red on every push and the dependency graph never received
    the transitive packages (measured on the 28 August 2026 runs). On Windows
    the property is inert.
  -->
  <PropertyGroup>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!--
      NuGet lock files (packages.lock.json beside each project). A restore
      records the exact package graph - every transitive version and its
      content hash - and CI restores with "dotnet restore ... -locked-mode",
      which fails rather than silently resolving something different from
      what was committed. That is the OpenSSF Scorecard Pinned-Dependencies
      finding for NuGet, and it is real: without a lock file, a floating
      transitive dependency or a re-published package version changes what
      ships without a commit saying so. On a developer machine a plain
      restore updates the lock file when a package reference changes; commit
      it with the change. Dependabot updates lock files with its bumps.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
