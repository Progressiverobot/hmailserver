<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Keep bin\Debug / bin\Release regardless of platform so scripts and the
         installer read one fixed path (same convention as ControlPanel). -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Shared</RootNamespace>
    <AssemblyName>Shared</AssemblyName>
    <Version>6.2.15</Version>
    <Product>hMailServer Shared Tools Library</Product>
    <Company>Progressive Robot Ltd</Company>
    <Copyright>Copyright (c) 2026 Christopher Holloway / Progressive Robot Ltd</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- tlbimp wrapper for the hMailServer COM API, checked in so the tools build
         without a registered typelib (regeneration: see ..\Interop\README.md). -->
    <Reference Include="Interop.hMailServer">
      <HintPath>..\Interop\Interop.hMailServer.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
