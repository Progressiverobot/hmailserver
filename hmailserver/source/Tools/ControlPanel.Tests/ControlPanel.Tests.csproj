<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>hMailServer.ControlPanel.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlPanel.Core\ControlPanel.Core.csproj" />
  </ItemGroup>

  <!-- Chart accessibility: the palette, the catalogue, the table view and the
       status vocabulary. These are compiled straight into the test assembly rather
       than routed through ControlPanel.Core, because the app compiles them too (they
       live under ControlPanel\Services) and adding them to Core as well would give
       this project two copies of every type and a CS0436 for each. They carry no WPF
       references for exactly this reason: the theme decisions and the table
       construction are the parts worth testing, and they must be testable without a
       dispatcher, without an Application, and without the build agent having to be
       running a High Contrast theme. -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\AccessibleNames.cs" />
    <Compile Include="..\ControlPanel\Services\SettingClaims.cs" />
    <Compile Include="..\ControlPanel\Services\ChartPalette.cs" />
    <Compile Include="..\ControlPanel\Services\ChartCatalog.cs" />
    <Compile Include="..\ControlPanel\Services\ChartDataTable.cs" />
    <Compile Include="..\ControlPanel\Services\StatusSemantics.cs" />
    <Compile Include="..\ControlPanel\Services\SpamPipeline.cs" />
    <!-- Same arrangement, for the same reason: the account comparison and the
         command-line parsing behind the service-account check are pure, and both
         drive a sentence shown to an administrator, so both are worth testing
         without a WPF page around them. -->
    <Compile Include="..\ControlPanel\Services\WindowsServiceInfo.cs" />
    <!-- The REST API key store. Every rule in it - the token's shape, the digest,
         what makes a label, a domain list or a source restriction acceptable - has
         to agree with RestApiServer, and a disagreement produces a key that is
         written successfully and authenticates nothing. That is exactly the class
         of bug a test catches and a green build does not. IniFeatureStore comes
         with it because ApiKeyStore locates the store file through it. -->
    <Compile Include="..\ControlPanel\Services\ApiKeyStore.cs" />
    <Compile Include="..\ControlPanel\Services\IniFeatureStore.cs" />
    <!-- Matching a configured port row against the machine's open ports. Both ways
         of getting it wrong cost something: a live port reported as down sends
         somebody hunting for a conflict that does not exist, and a dead port
         reported as up hides the commonest cause of "mail stopped arriving". -->
    <Compile Include="..\ControlPanel\Services\ListenerProbe.cs" />
    <!-- The two overview pages' judgement. Both answer a question no editing page
         can - "will an infected message actually be caught here", "is anything
         carrying a password in the clear" - and both do it by deriving consequences
         from settings rather than by displaying them. That derivation is the part
         worth testing, and it is deliberately free of WPF so it can be tested
         without a dispatcher or a live server. Neither pulls in ServerSession: the
         certificate expiry threshold they share with the certificates page lives in
         StatusSemantics above precisely so that it does not. -->
    <Compile Include="..\ControlPanel\Services\VirusPipeline.cs" />
    <Compile Include="..\ControlPanel\Services\TlsPosture.cs" />

    <!-- The report a directory synchronisation returns is one tab-separated string.
         Turning it into rows a page can count and sort is the only logic in that
         feature that does not need a directory, a server or a dispatcher, so it lives
         here on its own and is tested here on its own. -->
    <Compile Include="..\ControlPanel\Services\DirectorySyncReport.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- WindowsServiceInfo queries Win32_Service; the app gets this through its
         own reference and the test assembly needs its own. -->
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
